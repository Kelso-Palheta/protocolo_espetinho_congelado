---
import CapaModulo from '../components/CapaModulo.astro';

interface Props {
  title: string;
  description?: string;
  category: 'protocolo' | 'bonus' | 'modulo-liberado' | 'order-bump';
  chapterNumber?: number | string;
  chapterTitle: string;
  chapterSubtitle?: string;
  imagemCapa?: string;
  focoTecnico?: string;
  parametroChave?: string;
  prevLink?: { title: string; href: string };
  nextLink?: { title: string; href: string };
}

const {
  title,
  description = "Protocolo Espetinho Congelado — Guia Operacional Definitivo",
  category,
  chapterNumber,
  chapterTitle,
  chapterSubtitle,
  imagemCapa,
  focoTecnico,
  parametroChave,
  prevLink,
  nextLink
} = Astro.props;

const menuModules = [
  { group: "Protocolos Oficiais", items: [
    { num: "01", title: "Preparação: A Estrutura Mínima", href: "/protocolo-1" },
    { num: "02", title: "Produção: Da Matéria-Prima ao Espeto", href: "/protocolo-2" },
    { num: "03", title: "Padronização: O DNA do Espetinho", href: "/protocolo-3" },
    { num: "04", title: "Congelamento: Estoque Vendável", href: "/protocolo-4" },
    { num: "05", title: "Precificação: Custo Real e Lucro", href: "/protocolo-5" },
    { num: "06", title: "Oferta: Kits e Cardápios Lucrativos", href: "/protocolo-6" },
    { num: "07", title: "Venda: Divulgação e Primeiros Pedidos", href: "/protocolo-7" },
  ]},
  { group: "Módulos de Especialização (Bônus)", items: [
    { num: "B1", title: "Operação de Pedidos & Delivery", href: "/bonus-1" },
    { num: "B2", title: "Protocolo da Recompra e Recorrência", href: "/bonus-2" },
    { num: "B3", title: "Crescimento e Expansão Consciente", href: "/bonus-3" },
    { num: "B4", title: "Plano Prático Primeiros 7 Dias", href: "/bonus-4" },
  ]},
  { group: "Módulos Liberados (Kits Estratégicos)", items: [
    { num: "K1", title: "Kit WhatsApp Que Vende & Scripts", href: "/modulo-whatsapp-vendas", badge: "Liberado" },
    { num: "K2", title: "Kit Cardápio & Comunicação Visual", href: "/modulo-cardapio-visual", badge: "Liberado" },
  ]}
];

const categoryBadge = {
  protocolo: { text: `Protocolo ${chapterNumber || ''}`, color: "bg-amber-500/10 text-amber-400 border-amber-500/30" },
  bonus: { text: `Bônus Exclusivo ${chapterNumber || ''}`, color: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30" },
  'modulo-liberado': { text: `🌟 Módulo Liberado`, color: "bg-amber-400/20 text-amber-300 border-amber-400/40 shadow-sm shadow-amber-500/10" }
}[category];
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Protocolo Espetinho Congelado</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body class="bg-charcoal-950 text-zinc-100 font-sans antialiased selection:bg-amber-500 selection:text-charcoal-950 min-h-screen flex flex-col">
    
    <!-- Top Navigation Header -->
    <header class="top-nav-header sticky top-0 z-50 border-b border-charcoal-800/80 bg-charcoal-950/90 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-zinc-200 hover:text-amber-400 transition-colors group">
          <img src="/logo.png" alt="Logo Protocolo Espetinho Congelado" class="h-8 w-auto object-contain drop-shadow transition-transform group-hover:scale-105" />
          <span class="font-display font-bold text-lg tracking-tight">Protocolo <strong class="text-amber-500 font-extrabold">Espetinho</strong></span>
        </a>

        <div class="flex items-center gap-3">
          <span class={`text-xs font-mono font-bold tracking-wide px-3 py-1 rounded-full border ${categoryBadge.color}`}>
            {categoryBadge.text}
          </span>
          
          <!-- Sumário Drawer Trigger -->
          <button
            type="button"
            id="open-menu-btn"
            class="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg border border-charcoal-700 bg-charcoal-900 text-zinc-300 hover:text-white hover:border-amber-500/50 hover:bg-charcoal-800 transition-all cursor-pointer"
            aria-label="Abrir sumário de capítulos"
          >
            <span>☰</span>
            <span class="hidden sm:inline">Sumário</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Drawer Lateral de Navegação -->
    <div id="menu-overlay" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <aside id="menu-drawer" class="fixed top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-charcoal-900 border-l border-charcoal-800 z-50 translate-x-full transition-transform duration-300 overflow-y-auto p-6 shadow-2xl">
      <div class="flex items-center justify-between border-b border-charcoal-800 pb-4 mb-5">
        <h3 class="font-display font-bold text-base text-zinc-100 flex items-center gap-2">
          <span>📖</span> Sumário do E-book
        </h3>
        <button id="close-menu-btn" class="text-zinc-400 hover:text-white text-lg p-1">✕</button>
      </div>

      <div class="space-y-6 text-sm">
        {menuModules.map((group) => (
          <div>
            <h4 class="text-xs font-mono uppercase tracking-wider text-amber-500 font-bold mb-2">
              {group.group}
            </h4>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center justify-between p-2 rounded-lg text-zinc-300 hover:text-white hover:bg-charcoal-800/80 transition-colors group"
                  >
                    <span class="flex items-center gap-2 truncate">
                      <span class="text-xs font-mono text-zinc-400 group-hover:text-amber-400">{item.num}</span>
                      <span class="truncate text-xs">{item.title}</span>
                    </span>
                    {item.badge && (
                      <span class="text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30 px-1.5 py-0.5 rounded">
                        {item.badge}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>

    <!-- Capa Modular Oficial (Página 1 do PDF / Hero Editorial Web) -->
    <CapaModulo
      tipo={category}
      numero={chapterNumber}
      titulo={chapterTitle}
      subtitulo={chapterSubtitle}
      descricao={description}
      imagemFundo={imagemCapa}
      focoTecnico={focoTecnico}
      parametroChave={parametroChave}
    />

    <!-- Main Content Slot (Página 2 em diante no PDF) -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14 space-y-12 flex-1 w-full">
      <slot />

      <!-- Previous / Next Navigation Footer -->
      <nav class="navigation-footer flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-charcoal-800 mt-12">
        {prevLink ? (
          <a
            href={prevLink.href}
            class="w-full sm:w-auto text-center px-5 py-3 rounded-xl border border-charcoal-700 bg-charcoal-900 text-zinc-300 hover:text-white hover:border-zinc-500 text-sm font-medium transition-colors"
          >
            ← {prevLink.title}
          </a>
        ) : (
          <a
            href="/"
            class="w-full sm:w-auto text-center px-5 py-3 rounded-xl border border-charcoal-700 bg-charcoal-900 text-zinc-300 hover:text-white hover:border-zinc-500 text-sm font-medium transition-colors"
          >
            ← Painel Principal
          </a>
        )}

        {nextLink && (
          <a
            href={nextLink.href}
            class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-charcoal-950 text-sm font-bold shadow-lg shadow-amber-500/20 hover:brightness-110 transition-all"
          >
            {nextLink.title} →
          </a>
        )}
      </nav>
    </main>

    <!-- Footer -->
    <footer class="border-t border-charcoal-800/80 bg-charcoal-950 py-8 text-center text-xs text-zinc-400 mt-auto">
      <div class="max-w-4xl mx-auto px-4 space-y-2">
        <p>© {new Date().getFullYear()} Protocolo Espetinho Congelado. Guia Técnico Operacional.</p>
        <p class="text-[11px] text-zinc-400">Diagramado com parser semântico e ilustrações gastronômicas geradas por IA.</p>
      </div>
    </footer>

    <!-- Script for Drawer -->
    <script>
      function setupMenu() {
        const openBtn = document.getElementById('open-menu-btn');
        const closeBtn = document.getElementById('close-menu-btn');
        const drawer = document.getElementById('menu-drawer');
        const overlay = document.getElementById('menu-overlay');

        function open() {
          drawer?.classList.remove('translate-x-full');
          overlay?.classList.remove('opacity-0', 'pointer-events-none');
        }

        function close() {
          drawer?.classList.add('translate-x-full');
          overlay?.classList.add('opacity-0', 'pointer-events-none');
        }

        openBtn?.addEventListener('click', open);
        closeBtn?.addEventListener('click', close);
        overlay?.addEventListener('click', close);
      }

    </script>

    <style is:global>
      /* ====================================================================
         DESIGN SYSTEM & COMPONENTES GERAIS (TELA & EBOOK INTERATIVO)
         ==================================================================== */
      .prancha {
        width: 100%;
        margin-bottom: 2.5rem;
        box-sizing: border-box;
      }

      .card-prancha {
        background-color: #18181b;
        border: 1px solid #27272a;
        border-radius: 16px;
        padding: 24px 28px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-sizing: border-box;
        width: 100%;
        gap: 16px;
      }

      /* Editorial Split (58% Texto / 42% Mídia) */
      .editorial-split {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 24px;
        width: 100%;
        box-sizing: border-box;
      }

      .editorial-split.reverse {
        flex-direction: row-reverse;
      }

      .editorial-split.items-start {
        align-items: flex-start;
      }

      .editorial-col-text {
        flex: 0 0 58%;
        width: 58%;
        max-width: 58%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        box-sizing: border-box;
      }

      .editorial-col-media {
        flex: 0 0 calc(42% - 24px);
        width: calc(42% - 24px);
        max-width: calc(42% - 24px);
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
      }

      @media (max-width: 900px) {
        .editorial-split,
        .editorial-split.reverse {
          flex-direction: column !important;
          gap: 20px !important;
        }

        .editorial-col-text,
        .editorial-col-media {
          flex: 1 1 100% !important;
          width: 100% !important;
          max-width: 100% !important;
        }
      }

      /* Image Card */
      .editorial-image-card {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #27272a;
        background: #09090b;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .editorial-image-card img {
        width: 100%;
        height: 100%;
        min-height: 220px;
        object-fit: cover;
        display: block;
      }

      .editorial-image-caption {
        padding: 7px 12px;
        font-size: 11px;
        color: #a1a1aa;
        text-align: center;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        background-color: #121215;
        border-top: 1px solid #27272a;
        flex-shrink: 0;
      }

      /* Tipografia Editorial */
      .secao-titulo {
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        line-height: 1.25;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
      }

      .secao-intro {
        font-size: 14.5px;
        line-height: 1.55;
        color: #d4d4d8;
        margin-bottom: 6px;
      }

      .subtitulo-destaque {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #fbbf24;
        margin-bottom: 6px;
      }

      .destaque-tag {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #fbbf24;
        margin-bottom: 6px;
      }

      .secao-fechamento {
        font-size: 13.5px;
        line-height: 1.5;
        color: #a1a1aa;
        margin-top: 12px;
      }

      /* Lógica Inversa & Lista de Tópicos */
      .destaque-logica {
        background: rgba(245, 158, 11, 0.03);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 8px 0;
      }

      .lista-topicos {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .lista-topicos li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 13.5px;
        line-height: 1.45;
        color: #e4e4e7;
      }

      .marcador-amber {
        color: #f59e0b;
        font-weight: 900;
        font-size: 16px;
        flex-shrink: 0;
      }

      /* Quadrantes Grid */
      .quadrantes-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 8px;
      }

      @media (max-width: 640px) {
        .quadrantes-grid {
          grid-template-columns: 1fr !important;
        }
      }

      /* Subcards & Badges */
      .subcard-item {
        background-color: #121215;
        border: 1px solid #27272a;
        border-radius: 12px;
        padding: 14px 16px;
        box-sizing: border-box;
      }

      .subcard-titulo {
        font-size: 13px;
        font-weight: 700;
        color: #f4f4f5;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .subcard-texto {
        font-size: 12px;
        line-height: 1.45;
        color: #a1a1aa;
        margin: 0;
      }

      .subcard-mini {
        background-color: #18181b;
        border: 1px solid #27272a;
        border-radius: 10px;
        padding: 8px 12px;
        box-sizing: border-box;
      }

      .badge-tag {
        font-family: ui-monospace, monospace;
        font-size: 10.5px;
        padding: 3px 8px;
        border-radius: 5px;
        font-weight: 700;
      }

      .badge-tag.amber {
        color: #fbbf24;
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.35);
      }

      .badge-tag.emerald {
        color: #34d399;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
      }

      .badge-tag.zinc {
        color: #d4d4d8;
        background: #18181b;
        border: 1px solid #3f3f46;
      }

      .flavor-badge {
        height: 28px;
        width: 28px;
        border-radius: 50%;
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        font-weight: 800;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid rgba(245, 158, 11, 0.4);
      }

      /* Equipamentos Grid */
      .secao-equipamentos {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .equipamentos-grid {
        display: flex;
        flex-direction: row;
        gap: 18px;
        align-items: stretch;
        width: 100%;
      }

      .equipamentos-cards {
        flex: 0 0 58%;
        width: 58%;
        max-width: 58%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .equipamentos-media {
        flex: 0 0 calc(42% - 18px);
        width: calc(42% - 18px);
        max-width: calc(42% - 18px);
        display: flex;
        flex-direction: column;
      }

      @media (max-width: 900px) {
        .equipamentos-grid {
          flex-direction: column !important;
        }
        .equipamentos-cards,
        .equipamentos-media {
          flex: 1 1 100% !important;
          width: 100% !important;
          max-width: 100% !important;
        }
        .equipamentos-cards {
          grid-template-columns: 1fr !important;
        }
      }

      /* Alerta Não Comprar */
      .alerta-nao-comprar {
        border: 1px solid rgba(244, 63, 94, 0.3);
        background: rgba(244, 63, 94, 0.08);
        border-radius: 12px;
        padding: 12px 16px;
        box-sizing: border-box;
      }

      .alerta-titulo {
        font-size: 12.5px;
        font-weight: 700;
        color: #fda4af;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .alerta-itens-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        font-size: 11.5px;
        color: #f4f4f5;
        line-height: 1.4;
      }

      @media (max-width: 768px) {
        .alerta-itens-grid {
          grid-template-columns: 1fr !important;
        }
      }

      /* Sabores */
      .cards-sabores {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 10px 0;
      }

      /* Manutenção Seladora */
      .manutencao-card {
        background-color: #121215;
        border: 1px solid #27272a;
        border-radius: 12px;
        padding: 12px 16px;
        box-sizing: border-box;
      }

      .manutencao-titulo {
        font-size: 12px;
        font-weight: 700;
        color: #fbbf24;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
      }

      .manutencao-intro {
        font-size: 11.5px;
        line-height: 1.45;
        color: #d4d4d8;
        margin-bottom: 4px;
      }

      .manutencao-lista {
        list-style: disc;
        padding-left: 16px;
        margin: 0 0 4px 0;
        font-size: 11px;
        line-height: 1.4;
        color: #a1a1aa;
      }

      .manutencao-beneficio {
        font-size: 10.5px;
        line-height: 1.35;
        color: #fbbf24;
        margin: 0;
      }

      /* ====================================================================
         PRINT & EXPORTAÇÃO PDF (A4 PAISAGEM)
         ==================================================================== */
      @media print {
        @page {
          size: 297mm 210mm;
          margin: 0;
        }

        header.top-nav-header,
        #open-menu-btn,
        #close-menu-btn,
        #menu-drawer,
        #menu-overlay,
        .navigation-footer,
        nav,
        button,
        footer,
        .btn-navegacao,
        .no-print {
          display: none !important;
          visibility: hidden !important;
          height: 0 !important;
          margin: 0 !important;
          padding: 0 !important;
          opacity: 0 !important;
          pointer-events: none !important;
        }

        html, body {
          background-color: #09090b !important;
          color: #f4f4f5 !important;
          font-size: 14px !important;
          line-height: 1.55 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 297mm !important;
          height: 210mm !important;
          font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        }

        main,
        .main-content,
        .container {
          width: 100% !important;
          max-width: none !important;
          margin: 0 !important;
          padding: 0 !important;
          box-sizing: border-box !important;
          background: transparent !important;
          display: block !important;
        }

        .capa-modulo {
          page-break-before: avoid !important;
          break-before: avoid !important;
          page-break-after: always !important;
          break-after: page !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          height: 210mm !important;
          min-height: 210mm !important;
          max-height: 210mm !important;
          width: 297mm !important;
          max-width: 297mm !important;
          display: flex !important;
          flex-direction: column !important;
          justify-content: space-between !important;
          box-sizing: border-box !important;
          padding: 32px 44px !important;
          border-radius: 0 !important;
          border: none !important;
          background-color: #09090b !important;
          position: relative !important;
          overflow: hidden !important;
        }

        .prancha {
          page-break-before: always !important;
          break-before: page !important;
          page-break-after: avoid !important;
          break-after: avoid !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          height: 210mm !important;
          min-height: 210mm !important;
          max-height: 210mm !important;
          width: 297mm !important;
          max-width: 297mm !important;
          display: flex !important;
          flex-direction: column !important;
          justify-content: center !important;
          align-items: center !important;
          box-sizing: border-box !important;
          padding: 10mm 13mm !important;
          margin: 0 !important;
          overflow: hidden !important;
          background-color: #09090b !important;
        }

        .prancha:first-of-type {
          page-break-before: avoid !important;
          break-before: avoid !important;
        }

        .prancha > section,
        .prancha > .visual-block,
        .prancha > div,
        .prancha > .card-prancha {
          width: 100% !important;
          max-width: none !important;
          height: 100% !important;
          max-height: 100% !important;
          margin: 0 !important;
          box-sizing: border-box !important;
        }

        .card-prancha {
          height: 100% !important;
          padding: 20px 26px !important;
          overflow: hidden !important;
        }

        .editorial-split {
          height: 100% !important;
          flex: 1 1 auto !important;
          min-height: 0 !important;
