---
// Página de Vendas de Alta Conversão - Protocolo Espetinho Congelado
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Protocolo Espetinho Congelado | O Negócio Começa no Freezer</title>
  <meta name="description" content="Aprenda a transformar o freezer da sua casa em um estoque lucrativo de espetinhos artesanais a vácuo para vender por encomenda no WhatsApp.">
  <style>
    /* ==========================================================
       RESET & HIGH-PERFORMANCE NEURODESIGN (Connect Rate 95%+)
       ========================================================== */
    :root {
      --bg-main: #0a0b0e;
      --bg-card: #13151b;
      --bg-card-hover: #181b23;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-focus: rgba(247, 127, 0, 0.35);
      --text-main: #f3f4f6;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --accent-ember: #f77f00;
      --accent-amber: #f59e0b;
      --accent-crimson: #e63946;
      --accent-red-subtle: rgba(239, 68, 68, 0.15);
      --cta-green: #10b981;
      --cta-green-hover: #059669;
      --whatsapp-bg: #0b141a;
      --whatsapp-bubble: #005c4b;
      --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    body {
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(247, 127, 0, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 10% 30%, rgba(230, 57, 70, 0.04) 0%, transparent 35%),
        radial-gradient(circle at 90% 65%, rgba(245, 158, 11, 0.03) 0%, transparent 35%);
      background-attachment: fixed;
    }

    .container {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      padding: 0 16px;
    }

    /* ==========================================================
       PADRONIZAÇÃO DOS TÍTULOS DE TODAS AS SEÇÕES
       ========================================================== */
    .section-title {
      font-size: 1.7rem;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
      text-align: center;
      line-height: 1.25;
    }

    .section-title span.highlight-amber {
      background: linear-gradient(135deg, #fbbf24 0%, #f77f00 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .section-subtitle {
      font-size: 0.88rem;
      color: var(--text-muted);
      max-width: 640px;
      margin: 0 auto 26px;
      line-height: 1.45;
      text-align: center;
    }

    /* ==========================================================
       TOP NOTIFICATION BAR
       ========================================================== */
    .top-bar {
      text-align: center;
      padding: 9px 14px;
      background: rgba(19, 21, 27, 0.94);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border-subtle);
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--accent-amber);
      letter-spacing: 0.5px;
    }

    /* ==========================================================
       HERO SECTION (PRIMEIRA DOBRA)
       ========================================================== */
    .hero {
      padding: 34px 0 24px;
      text-align: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 50px;
      color: #fbbf24;
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 16px;
    }

    .hero-title {
      font-size: 2.1rem;
      line-height: 1.2;
      font-weight: 900;
      letter-spacing: -0.6px;
      margin-bottom: 14px;
    }

    .hero-title span.highlight {
      display: block;
      margin-top: 8px;
      background: linear-gradient(135deg, #ff4d5a 0%, #f77f00 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .mockup-container {
      position: relative;
      width: 100%;
      max-width: 680px;
      margin: 14px auto 14px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .mockup-img {
      width: 100%;
      height: auto;
      max-height: 310px;
      object-fit: contain;
      filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.85)) drop-shadow(0 0 22px rgba(247, 127, 0, 0.12));
    }

    .hero-subtitle {
      font-size: 0.88rem;
      line-height: 1.45;
      color: var(--text-muted);
      max-width: 620px;
      margin: 0 auto 14px;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      max-width: 390px;
      padding: 14px 20px;
      background: linear-gradient(135deg, var(--cta-green) 0%, var(--cta-green-hover) 100%);
      color: #ffffff;
      text-decoration: none;
      font-size: 0.96rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-radius: 10px;
      box-shadow: 0 10px 22px rgba(16, 185, 129, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px rgba(16, 185, 129, 0.45);
    }

    .cta-subtext {
      font-size: 0.72rem;
      color: var(--text-dim);
      margin-top: 5px;
    }

    /* ==========================================================
       RUMINAÇÕES MENTAIS
       ========================================================== */
    .pain-box {
      margin: 32px 0 38px;
      padding: 24px 18px;
      background: linear-gradient(180deg, rgba(25, 28, 36, 0.7) 0%, rgba(19, 21, 27, 0.95) 100%);
      border: 1px solid var(--border-subtle);
      border-left: 4px solid var(--accent-ember);
      border-radius: 14px;
    }

    .pain-box h3 {
      font-size: 1.12rem;
      font-weight: 800;
      margin-bottom: 14px;
      color: #fff;
    }

    .thought-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    .thought-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.88rem;
      color: #cbd5e1;
      font-style: italic;
    }

    .thought-item svg {
      flex-shrink: 0;
      width: 15px;
      height: 15px;
      fill: var(--accent-ember);
      margin-top: 3px;
    }

    /* ==========================================================
       MARCADORES VISUAIS DE COMPARAÇÃO
       ========================================================== */
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 35px 0;
    }

    .compare-col {
      padding: 22px 18px;
      border-radius: 14px;
    }

    .col-bad {
      background: rgba(239, 68, 68, 0.03);
      border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .col-good {
      background: rgba(247, 127, 0, 0.03);
      border: 1px solid rgba(247, 127, 0, 0.25);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .compare-col h4 {
      font-size: 1.02rem;
      font-weight: 800;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .col-bad h4 { color: #f87171; }
    .col-good h4 { color: #fbbf24; }

    .compare-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 11px;
      font-size: 0.86rem;
      color: #cbd5e1;
    }

    .compare-list li {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      line-height: 1.38;
    }

    .marker-bad {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 17px;
      height: 17px;
      border-radius: 4px;
      background: var(--accent-red-subtle);
      border: 1px solid rgba(239, 68, 68, 0.35);
      color: #f87171;
      font-size: 0.68rem;
      font-weight: 900;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .marker-good {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 17px;
      height: 17px;
      border-radius: 4px;
      background: rgba(247, 127, 0, 0.15);
      border: 1px solid rgba(247, 127, 0, 0.35);
      color: #fbbf24;
      font-size: 0.72rem;
      font-weight: 900;
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* ==========================================================
       SEÇÃO: COMO A OPERAÇÃO FUNCIONA NA PRÁTICA (3 ETAPAS)
       ========================================================== */
    .steps-section {
      margin: 42px 0 48px;
      text-align: center;
    }

    .steps-modular-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      align-items: stretch;
    }

    .step-img-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.6);
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      display: flex;
    }

    .step-img-card:hover {
      transform: translateY(-3px);
      border-color: rgba(247, 127, 0, 0.35);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.75), 0 0 20px rgba(247, 127, 0, 0.1);
    }

    .step-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ==========================================================
       OS 7 PROTOCOLOS (GRID VISUAL 3D)
       ========================================================== */
    .protocols-section {
      margin: 48px 0 52px;
    }

    .protocols-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 13px;
      margin-top: 24px;
    }

    .card-3d {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      box-shadow: 0 10px 25px -8px rgba(0, 0, 0, 0.6);
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .card-3d:hover {
      transform: translateY(-3px);
      border-color: rgba(247, 127, 0, 0.3);
    }

    .proto-tag {
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--accent-ember);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .proto-title {
      font-size: 0.96rem;
      font-weight: 700;
      color: #fff;
    }

    .proto-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* ==========================================================
       PROVA SOCIAL (WHATSAPP DEPOIMENTOS)
       ========================================================== */
    .social-proof {
      margin: 48px 0 52px;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 15px;
      margin-top: 22px;
    }

    .wa-card {
      background: var(--whatsapp-bg);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

    .wa-header {
      display: flex;
      align-items: center;
      gap: 9px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding-bottom: 8px;
    }

    .wa-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f77f00, #e63946);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.82rem;
      color: #fff;
    }

    .wa-user {
      font-size: 0.84rem;
      font-weight: 700;
      color: #fff;
    }

    .wa-city {
      font-size: 0.68rem;
      color: var(--text-dim);
    }

    .wa-msg {
      background: var(--whatsapp-bubble);
      color: #e9edef;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .wa-meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      font-size: 0.64rem;
      color: rgba(255, 255, 255, 0.6);
      margin-top: 4px;
    }

    .wa-checks {
      color: #53bdeb;
      font-size: 0.78rem;
      line-height: 1;
    }

    /* ==========================================================
       BÔNUS
       ========================================================== */
    .bonus-box {
      background: linear-gradient(180deg, #151820 0%, #101217 100%);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 26px 20px;
      margin: 36px 0;
    }

    .bonus-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 13px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .bonus-item:last-child { border-bottom: none; }

    .bonus-info {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      flex: 1;
    }

    .bonus-badge {
      background: rgba(247, 127, 0, 0.12);
      color: var(--accent-ember);
      padding: 4px 7px;
      border-radius: 5px;
      font-weight: 800;
      font-size: 0.72rem;
      height: fit-content;
      flex-shrink: 0;
    }

    .bonus-pricing {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      flex-shrink: 0;
      gap: 3px;
      padding-left: 10px;
    }

    .bonus-price-strike {
      font-size: 0.84rem;
      font-weight: 700;
      color: #ef4444;
      text-decoration: line-through;
      text-decoration-color: #ef4444;
      text-decoration-thickness: 1.8px;
      white-space: nowrap;
    }

    .bonus-price-free {
      font-size: 0.72rem;
      font-weight: 900;
      color: #10b981;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 2px 7px;
      border-radius: 4px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .bonus-total-banner {
      margin-top: 18px;
      padding: 12px 16px;
      background: rgba(245, 158, 11, 0.08);
      border: 1px dashed rgba(245, 158, 11, 0.35);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .bonus-total-text {
      font-size: 0.82rem;
      color: #e2e8f0;
      font-weight: 600;
    }

    .bonus-total-values {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .bonus-total-strike {
      font-size: 0.88rem;
      color: #ef4444;
      text-decoration: line-through;
      font-weight: 700;
      text-decoration-color: #ef4444;
      text-decoration-thickness: 1.5px;
    }

    .bonus-total-free {
      font-size: 0.82rem;
      color: #10b981;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.35);
      padding: 3px 8px;
      border-radius: 4px;
    }

    /* ==========================================================
       CARD DA OFERTA (CHECKOUT)
       ========================================================== */
    .offer-card {
      max-width: 520px;
      margin: 38px auto;
      padding: 32px 20px;
      text-align: center;
      background: radial-gradient(circle at 50% 0%, rgba(247, 127, 0, 0.1) 0%, #12141a 75%);
      border: 1px solid rgba(247, 127, 0, 0.3);
      border-radius: 18px;
      position: relative;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.8), 0 0 30px rgba(247, 127, 0, 0.08);
    }

    .badge-deal {
      position: absolute;
      top: -11px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent-amber);
      color: #0f172a;
      padding: 3px 14px;
      border-radius: 50px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
    }

    .offer-brand-lockup {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      margin: 10px auto 4px;
      text-align: left;
    }

    .offer-brand-logo {
      height: 64px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.6));
      flex-shrink: 0;
    }

    .offer-brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.12;
    }

    .brand-line-1 {
      font-family: 'Outfit', var(--font);
      font-size: 1.4rem;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -0.5px;
    }

    .brand-amber {
      color: #f59e0b;
    }

    .brand-line-2 {
      font-family: 'Outfit', var(--font);
      font-size: 1.62rem;
      font-weight: 900;
      color: #f59e0b;
      letter-spacing: -0.5px;
    }

    .price-strike-wrapper {
      margin-top: 8px;
      margin-bottom: 2px;
    }

    .price-strike {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 1.15rem;
      font-weight: 800;
      color: #ef4444;
      text-decoration: line-through;
      text-decoration-color: #ef4444;
      text-decoration-thickness: 2.5px;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 4px 14px;
      border-radius: 50px;
      letter-spacing: 0.3px;
    }

    .price-current {
      font-size: 3.2rem;
      font-weight: 900;
      color: #ffffff;
      line-height: 1;
      margin: 5px 0 4px;
      letter-spacing: -1px;
    }

    .price-current span {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--accent-ember);
      margin-right: 2px;
    }

    .price-sub {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.8rem;
      color: #94a3b8;
      font-weight: 500;
      margin-bottom: 18px;
    }

    .price-sub span.dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: #475569;
    }

    /* ==========================================================
       GARANTIA & FAQ
       ========================================================== */
    .guarantee-box {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 18px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      margin: 30px 0;
    }

    .guarantee-box svg {
      width: 42px;
      height: 42px;
      fill: var(--accent-amber);
      flex-shrink: 0;
    }

    .faq-section {
      margin: 44px 0 52px;
    }

    .faq-item {
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      margin-bottom: 8px;
      background: var(--bg-card);
      overflow: hidden;
    }

    .faq-item summary {
      padding: 14px 15px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
    }

    .faq-item summary::-webkit-details-marker { display: none; }

    .faq-item summary::after {
      content: '+';
      font-size: 1.25rem;
      color: var(--accent-ember);
      transition: transform 0.2s;
    }

    .faq-item[open] summary::after {
      content: '−';
    }

    .faq-content {
      padding: 0 15px 15px;
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.45;
    }

    /* ==========================================================
       RESPONSIVIDADE MOBILE
       ========================================================== */
    @media (max-width: 768px) {
      .hero { padding: 24px 0 18px; }
      .eyebrow { font-size: 0.72rem; padding: 4px 12px; margin-bottom: 12px; }
      .hero-title { font-size: 1.45rem; margin-bottom: 10px; line-height: 1.22; }
      .hero-title span.highlight { margin-top: 6px; }
      
      .mockup-container { width: 100%; max-width: 100%; margin: 8px auto 12px; }
      .mockup-img { max-height: 250px; width: 100%; }
      
      .hero-subtitle { font-size: 0.84rem; line-height: 1.4; margin: 0 auto 14px; max-width: 100%; }
      .cta-btn { font-size: 0.94rem; padding: 14px 18px; border-radius: 9px; max-width: 100%; }
      .cta-subtext { font-size: 0.7rem; margin-top: 5px; }

      .section-title { font-size: 1.35rem; line-height: 1.25; }
      .section-subtitle { font-size: 0.82rem; margin-bottom: 20px; }

      .compare-grid { grid-template-columns: 1fr; }
      
      .steps-modular-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .step-img-card {
        max-width: 420px;
        margin: 0 auto;
      }

      .bonus-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      .bonus-pricing {
        flex-direction: row;
        align-items: center;
        align-self: flex-end;
