---
import EbookLayout from '../layouts/EbookLayout.astro';
import VisualBlock from '../components/VisualBlock.astro';
import CalloutAlerta from '../components/CalloutAlerta.astro';
import TabelaTecnica from '../components/TabelaTecnica.astro';
import ChecklistOperacional from '../components/ChecklistOperacional.astro';
import imgPlano7Dias from '../assets/illustrations/bonus-4-plano-7-dias.png';
import imgCapa from '../assets/illustrations/capa-bonus-4.png';
---

<EbookLayout
  title="Bônus 4 — Plano Primeiros 7 Dias: O Roteiro de Execução Prática"
  category="bonus"
  chapterNumber="04"
  chapterTitle="BÔNUS 4 — PLANO PRIMEIROS 7 DIAS"
  chapterSubtitle="O Roteiro Passo a Passo de Execução Diária: Da Bancada ao Primeiro Cliente"
  imagemCapa={imgCapa.src}
  prevLink={{ title: "Bônus 3: Expansão", href: "/bonus-3" }}
  nextLink={{ title: "Kit WhatsApp Que Vende", href: "/modulo-whatsapp-vendas" }}
>
  <!-- Bloco Visual com Ilustração Gerada via IA -->
  <VisualBlock
    stepNumber="B4"
    badge="Execução & Ação Rápida"
    title="O Roteiro Diário Que Destrava a Operação"
    subtitle="Uma única missão por dia para colocar os kits no freezer sem estresse"
    description="O maior obstáculo de quem começa não é a falta de técnica, mas a paralisia por excesso de informação. Tentar aprender, cortar, precificar e vender no mesmo dia gera sobrecarga. Este plano fraciona todo o método em 7 tarefas diárias simples e sequenciais."
    tip="Não tente pular etapas ou antecipar dias. Cumpra a missão do dia com excelência e descanse. No 7º dia o seu ciclo estará completo e validado."
    imageSrc={imgPlano7Dias.src}
    imageAlt="Cronograma semanal em prancheta de madeira com espetinhos embalados a vácuo ao lado"
    imagePosition="left"
  />

  <!-- 1. A FILOSOFIA DE EXECUÇÃO -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h2 class="font-display text-xl md:text-2xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">1.</span> A Filosofia de Execução: Como Sair da Teoria Sem Paralisia
    </h2>
    <p class="text-zinc-300 text-sm md:text-base leading-relaxed">
      O maior obstáculo de quem compra um treinamento operacional é a paralisia por excesso de informação. Tentar aprender tudo, comprar carne, cortar, precificar, montar cardápio e vender no mesmo dia gera estresse, sobrecarrega a rotina doméstica e faz a pessoa desistir antes de ver o primeiro produto pronto no freezer.
    </p>
    <p class="text-zinc-300 text-sm md:text-base leading-relaxed">
      O <strong class="text-amber-400">Plano Primeiros 7 Dias</strong> foi estruturado como uma esteira de execução diária:
    </p>
    <ul class="space-y-2 text-sm text-zinc-300">
      <li class="flex items-start gap-2.5">
        <span class="text-amber-500 font-bold">•</span>
        <div>Cada dia tem <strong>uma única missão clara e objetiva</strong>.</div>
      </li>
      <li class="flex items-start gap-2.5">
        <span class="text-amber-500 font-bold">•</span>
        <div>Você só executa a tarefa designada para aquele dia específico, sem tentar antecipar etapas ou pular processos.</div>
      </li>
      <li class="flex items-start gap-2.5">
        <span class="text-amber-500 font-bold">•</span>
        <div>Ao final de 7 dias de trabalho focado e fracionado, sua produção caseira estará pronta, padronizada, congelada, precificada e divulgada para receber as primeiras encomendas.</div>
      </li>
    </ul>

    <!-- Nota de Responsabilidade Operacional -->
    <CalloutAlerta
      tipo="norma"
      titulo="Nota de Responsabilidade Operacional"
      destaque="Compromisso Real"
      mensagem="Este plano é um guia prático de execução e organização da sua rotina de trabalho. O objetivo é colocar o produto na rua e a operação em movimento estruturado, sem promessas irresponsáveis de enriquecimento rápido, volume mágico de vendas ou garantias de faturamento fixo no sétimo dia."
    />
  </section>

  <!-- 2. DIA 1 — ESCOLHER (DIAGNÓSTICO E DEFINIÇÃO DO MIX) -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">2.</span> DIA 1 — ESCOLHER (Diagnóstico e Definição do Mix)
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Validar a estrutura física da sua casa e escolher exatamente o que você vai produzir primeiro.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Diagnóstico da Cozinha:</em> Verifique se a bancada de trabalho está limpa, se a pia está desimpedida e se há espaço reservado no congelador ou freezer para comportar pelo menos duas assadeiras de pré-congelamento.</p>
        <p>2. <em>Conferência de Utensílios:</em> Separe a balança digital de precisão (teste as pilhas), a tábua plástica de corte atóxico e certifique-se de que sua principal faca de corte está bem afiada.</p>
        <p>3. <em>Escolha dos Sabores Iniciais:</em> Não invente receitas mirabolantes. Defina a grade de partida com no máximo 2 a 3 sabores consolidados (exemplo: Bovino Tradicional com miolo de alcatra ou acém limpo, Frango em cubos com bacon e Linguiça toscana).</p>
      </div>
      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Mapa da Estrutura Mínima e Checklist de Equipamentos.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 1:</strong> Bancada avaliada, utensílios separados e sabores de estreia definidos.</p>
    </div>
  </section>

  <!-- 3. DIA 2 — COMPRAR (INSUMOS E MATERIAIS DE PRODUÇÃO) -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">3.</span> DIA 2 — COMPRAR (Insumos e Materiais de Produção)
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Fazer o abastecimento de matéria-prima e consumíveis de forma controlada, comprando apenas o estritamente necessário para o primeiro lote piloto.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Elaboração da Lista de Compras:</em> Anote a quantidade exata de carne para produzir o lote inicial (exemplo: 2 kg de corte bovino, 2 kg de peito/sobrecoxa de frango, 1 kg de bacon e 1,5 kg de linguiça).</p>
        <p>2. <em>Compra das Carnes:</em> Vá ao açougue parceiro e compre cortes frescos e resfriados (evite carnes já previamente congeladas para não descongelar e recongelar na manipulação).</p>
        <p>3. <em>Compra de Embalagens e Insumos:</em> Adquira 1 pacote de palitos de bambu/madeira de 25 cm, 1 pacote de sacos plásticos de polietileno grosso (gramatura superior a 0,08 mm), etiquetas adesivas plásticas resistentes ao frio, filme PVC e os temperos secos da fórmula oficial (alho em pó, cebola granulada, páprica defumada, sal e óleo vegetal).</p>
      </div>
      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Lista de Compras Inicial.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 2:</strong> Todos os insumos armazenados corretamente na geladeira e despensa de casa, com os valores pagos guardados para a precificação.</p>
    </div>
  </section>

  <!-- 4. DIA 3 — PRODUZIR (CORTE, MARINADA E MONTAGEM) -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">4.</span> DIA 3 — PRODUZIR (Corte, Marinada e Montagem)
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Manipular a carne, temperar e montar os primeiros espetinhos físicos na bancada.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Uso de Palitos Secos:</em> Utilize os palitos de bambu de 25 cm totalmente secos direto do pacote higienizado. Não hidrate os palitos em água, evitando que a umidade migre para a seladora térmica ou crie cristais de gelo dentro da embalagem a vácuo.</p>
        <p>2. <em>Toalete e Pesagem:</em> Pese a peça de carne bruta no açougue, faça a limpeza de nervos e peles com a ponta da faca e anote o peso limpo que sobrou na tábua (guardando as aparas limpas para moer depois).</p>
        <p>3. <em>Corte em Cubos Uniformes:</em> Fatie a carne contra o sentido da fibra em tiras de 2,5 cm a 3,0 cm e depois em cubos regulares proporcionais.</p>
        <p>4. <em>Marinada Protetora:</em> Misture a carne em uma camada leve de azeite/óleo vegetal e adicione os condimentos secos e sal na medida exata da Ficha Técnica, deixando descansar por 20 minutos na geladeira.</p>
        <p>5. <em>Espetamento:</em> Monte os espetinhos centralizando a ponta do palito no meio dos cubos (4 a 5 pedaços por palito), preservando a reserva de empunhadura de cerca de 7 cm na base do palito.</p>
      </div>
      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Ficha de Produção e Controle de Rendimento.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 3:</strong> Primeiro lote físico montado na bancada e rendimento de palitos por quilo anotado.</p>
    </div>
  </section>

  <!-- 5. DIA 4 — PADRONIZAR & CONGELAR (DNA E ESTOQUE) -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">5.</span> DIA 4 — PADRONIZAR & CONGELAR (DNA e Estoque)
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Padronizar, Embalar a Vácuo & Estocar.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Pesagem de Calibragem:</em> Pese as unidades e ajuste os cubos na balança dentro da faixa oficial de tolerância.</p>
        <p>2. <em>Pré-Resfriamento (0°C a 5°C):</em> Mantenha as bandejas com os espetos montados na geladeira por 30 a 60 minutos para firmar a gordura e os tecidos antes do vácuo.</p>
        <p>3. <em>Embalagem a Vácuo Fracionada:</em> Acondicione os espetos alinhados nos sacos gofrados de 0,18 mm (em frações de 2 a 4 unidades por pacote) e acione a seladora com a borda perfeitamente seca.</p>
        <p>4. <em>Congelamento em Camada Fina (-18°C):</em> Distribua os pacotes selados no freezer sem empilhar durante as primeiras 6 horas, garantindo congelamento rápido e sem deformações.</p>
      </div>

      <!-- Alerta Crítico: Afastamento das Paredes com Gelo -->
      <div class="p-3 rounded-lg bg-amber-950/40 border border-amber-500/40 text-amber-200 text-xs space-y-1 mt-2">
        <strong class="text-amber-400 block font-bold">Afastamento das Paredes com Gelo:</strong>
        <p>Nunca encoste os sacos selados a vácuo diretamente nas paredes internas do freezer que possuam crostas ou camadas de gelo acumulado. A umidade do ambiente funde a embalagem plástica à parede congelada; ao tentar puxar o pacote com força para atender um pedido, o plástico se rasga, ocorrendo a perda imediata do vácuo daquele lote. Utilize gavetas plásticas, divisórias ou cestos organizadores aramados para manter os pacotes a pelo menos 2 cm das superfícies de congelamento do equipamento.</p>
      </div>

      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Checklist de Congelamento, Modelo de Etiqueta e Controle de Estoque.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 4:</strong> Pacotes devidamente identificados, selados e congelados de forma solta no freezer, compondo o primeiro estoque pronto para venda.</p>
    </div>
  </section>

  <!-- 6. DIA 5 — PRECIFICAR & MONTAR O CARDÁPIO -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">6.</span> DIA 5 — PRECIFICAR & MONTAR O CARDÁPIO (Custos e Oferta)
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Aplicar os números reais obtidos nos dias anteriores para formar preços lucrativos e montar seu cardápio digital.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Cálculo na Calculadora Oficial:</em> Abra a Calculadora de Custos e insira os dados reais: preço da carne limpa, custo rateado de palitos, embalagens, temperos e a taxa operacional doméstica.</p>
        <p>2. <em>Definição do Preço de Tabela:</em> Aplique a margem recomendada de 40% a 50% e estabeleça o preço de venda unitário e dos pacotes fechados.</p>
        <p>3. <em>Criação dos Kits:</em> Monte a grade de combos: Kit 1 (Degustação/Casal - 10 a 12 unidades), Kit 2 (Família - 20 a 24 unidades) e Kit 3 (Galera - 40 a 50 unidades), calculando o preço promocional com base na mescla de carnes nobres e suínas.</p>
        <p>4. <em>Preenchimento do Cardápio:</em> Monte o arquivo vertical de 1 página contendo os kits em destaque, preço avulso ancorado riscado, regras de pedido mínimo e opções de retirada/entrega.</p>
      </div>
      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Calculadora Oficial de Custos & Preço, Matriz de Kits e Modelo de Cardápio.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 5:</strong> Tabela de preços fechada com garantia de lucro e cardápio digital salvo no celular pronto para envio.</p>
    </div>
  </section>

  <!-- 7. DIA 6 — DIVULGAR (ATIVANDO OS PRIMEIROS CANAIS) -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">7.</span> DIA 6 — DIVULGAR (Ativando os Primeiros Canais)
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Preparar seu canal de vendas e apresentar a novidade para as pessoas mais próximas da sua região.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Configuração do WhatsApp:</em> Ajuste a foto de perfil comercial, preencha a biografia com a descrição do serviço de espetinhos congelados e salve os atalhos de resposta rápida com o cardápio e dados Pix.</p>
        <p>2. <em>Publicação de Bastidores:</em> Poste nos Status do WhatsApp e no Instagram fotos limpas do produto montado na bancada e das bandejas de congelamento, com a mensagem: <em class="text-amber-200">"Lotes artesanais da semana prontos no freezer! Encomendas abertas para o fim de semana"</em>.</p>
        <p>3. <em>Disparo Individual do Script de Lançamento:</em> Selecione de 20 a 30 contatos pessoais do seu círculo próximo (amigos, vizinhos, colegas de trabalho e parentes) e envie a mensagem individual de apresentação com o cardápio em anexo, de forma natural e sem criar grupos invasivos.</p>
      </div>
      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Scripts Básicos de Comunicação e Checklist de Divulgação.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 6:</strong> Imagem profissional consolidada nos canais de mensagem e rede de contatos ciente de que você possui estoque disponível.</p>
    </div>
  </section>

  <!-- 8. DIA 7 — BUSCAR OS PRIMEIROS PEDIDOS & ENTREGAR -->
  <section class="rounded-2xl border border-charcoal-800 bg-charcoal-900/60 p-6 md:p-8 space-y-4">
    <h3 class="font-display text-lg md:text-xl font-bold text-zinc-100 flex items-center gap-2.5">
      <span class="text-amber-500">8.</span> DIA 7 — BUSCAR OS PRIMEIROS PEDIDOS & ENTREGAR
    </h3>
    <div class="p-3.5 rounded-xl bg-charcoal-950/80 border border-charcoal-800 text-xs md:text-sm text-zinc-300 space-y-2">
      <p><strong class="text-amber-400">Missão do Dia:</strong> Prestar atendimento ágil, fechar as primeiras encomendas de kits e realizar as entregas ou retiradas programadas.</p>
      <p><strong class="text-amber-400">Tarefas Práticas:</strong></p>
      <div class="pl-3 border-l border-charcoal-800 space-y-1.5 text-xs text-zinc-300">
        <p>1. <em>Atendimento Ativo:</em> Responda rapidamente aos interessados que viram seus Status ou receberam a mensagem de lançamento, direcionando as dúvidas para o Kit Família (o campeão de vendas).</p>
        <p>2. <em>Registro no Controle de Pedidos:</em> Anote no caderno ou planilha o nome de cada comprador, kits solicitados, horário combinado e endereço de entrega (se houver).</p>
        <p>3. <em>Cobrança:</em> Confirme o recebimento do Pix antecipado para garantir a reserva do lote no freezer.</p>
        <p>4. <em>Expedição Cuidadosa:</em> Separe os pacotes do freezer apenas no momento da entrega, utilizando sacolas reforçadas para retirada no portão ou a caixa térmica com gelo rígido reutilizável caso vá fazer delivery na vizinhança.</p>
      </div>
      <p><strong class="text-amber-400">Ferramenta do Dia:</strong> Controle de Pedidos e Checklist de Conferência Pré-Saída.</p>
      <p><strong class="text-amber-400">Resultado ao Final do Dia 7:</strong> Primeiros pacotes entregues em mãos, dinheiro das primeiras vendas no caixa e o ciclo operacional completo validado na prática.</p>
    </div>
  </section>

  <!-- 9. CHECKLIST CONSOLIDADO DO PLANO 7 DIAS -->
  <ChecklistOperacional
    titulo="9. Checklist Consolidado do Plano 7 Dias"
    subtitulo="Marque cada dia após a conclusão integral das atividades práticas:"
    itens={[
      { texto: "DIA 1: Estrutura doméstica avaliada, utensílios separados e sabores iniciais definidos", obrigatorio: true, detalhe: "Bancada limpa e mix validado." },
      { texto: "DIA 2: Carnes frescas, palitos secos, plásticos, etiquetas e temperos comprados", obrigatorio: true, detalhe: "Abastecimento com notas e gramaturas anotadas." },
      { texto: "DIA 3: Carne limpa, cortada em cubos uniformes, marinada aplicada e espetos montados", obrigatorio: true, detalhe: "Lote montado e rendimento aferido." },
      { texto: "DIA 4: Espetinhos calibrados em 100g, pré-congelados soltos, ensacados a vácuo e catalogados", obrigatorio: true, detalhe: "Estoque solto e protegido a -18°C sem encostar no gelo." },
      { texto: "DIA 5: Custos calculados na ferramenta oficial, kits estruturados e cardápio digital pronto", obrigatorio: true, detalhe: "Margem de 40% a 50% e arquivo vertical para celular." },
      { texto: "DIA 6: WhatsApp comercial configurado, fotos nos Status e script enviado para contatos", obrigatorio: true, detalhe: "20 a 30 mensagens individuais disparadas." },
      { texto: "DIA 7: Atendimentos realizados, encomendas reservadas no Controle e primeiras entregas cumpridas", obrigatorio: true, detalhe: "Primeiro dinheiro no caixa e ciclo operacional validado." }
    ]}
  />
</EbookLayout>
