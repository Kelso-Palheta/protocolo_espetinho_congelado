---
import EbookLayout from '../layouts/EbookLayout.astro';
import VisualBlock from '../components/VisualBlock.astro';
import CalloutAlerta from '../components/CalloutAlerta.astro';
import TabelaTecnica from '../components/TabelaTecnica.astro';
import ChecklistOperacional from '../components/ChecklistOperacional.astro';
import imgPlano7Dias from '../assets/illustrations/bonus-4-plano-7-dias.png';
import imgCapa from '../assets/illustrations/capa-bonus-4.png';
---

<EbookLayout
  title="Bônus 4 — Plano Primeiros 7 Dias: O Roteiro de Execução Prática"
  category="bonus"
  chapterNumber="04"
  chapterTitle="BÔNUS 4 — PLANO PRIMEIROS 7 DIAS"
  chapterSubtitle="O Roteiro Passo a Passo de Execução Diária: Da Bancada ao Primeiro Cliente"
  imagemCapa={imgCapa.src}
  prevLink={{ title: "Bônus 3: Expansão", href: "/bonus-3" }}
  nextLink={{ title: "Kit WhatsApp Que Vende", href: "/modulo-whatsapp-vendas" }}
>
  <!-- Prancha 2: Bloco Visual Hero (Ocupação Nobre de 90% da Página) -->
  <div class="prancha">
    <VisualBlock
      stepNumber="B4"
      badge="Execução & Ação Rápida"
      title="O Roteiro Diário Que Destrava a Operação"
      subtitle="Uma única missão por dia para colocar os kits no freezer sem estresse"
      description="O maior obstáculo de quem começa não é a falta de técnica, mas a paralisia por excesso de informação. Tentar aprender, cortar, precificar e vender no mesmo dia gera sobrecarga. Este plano fraciona todo o método em 7 tarefas diárias simples e sequenciais."
      tip="Não tente pular etapas ou antecipar dias. Cumpra a missão do dia com excelência e descanse. No 7º dia o seu ciclo estará completo e validado."
      imageSrc={imgPlano7Dias.src}
      imageAlt="Cronograma semanal em prancheta de madeira com espetinhos embalados a vácuo ao lado"
      imagePosition="left"
    />
  </div>

  <!-- Prancha 3: Seção 1 - A Filosofia de Execução: Como Sair da Teoria Sem Paralisia -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-2">
        <h2 class="secao-titulo">
          <span class="text-amber-500">1.</span> A Filosofia de Execução: Como Sair da Teoria Sem Paralisia
        </h2>
        <p class="secao-intro">
          O maior obstáculo do iniciante é a paralisia por excesso de informação. Querer aprender tudo, comprar carne, precificar e vender no mesmo dia gera sobrecarga e desistência. O Plano foi criado como uma esteira diária:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Princípio 01</span>
              <span class="text-xs text-amber-400 font-mono font-bold">1 Missão / Dia</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Foco Fracionado</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Cada dia tem uma única missão clara. Você executa apenas a tarefa do dia e descansa com a sensação de dever cumprido.
            </p>
          </div>
        </div>

        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag zinc">Princípio 02</span>
              <span class="text-xs text-zinc-400 font-mono">Sem Atropelos</span>
            </div>
            <h3 class="subcard-titulo text-xs">Respeito ao Processo</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Proibido pular processos ou tentar adiantar etapas. A pressa gera cortes despadronizados e erros de pesagem.
            </p>
          </div>
        </div>

        <div class="subcard-item p-4 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Princípio 03</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">7º Dia</span>
            </div>
            <h3 class="subcard-titulo text-xs text-emerald-300">Ciclo 100% Validado</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Ao final dos 7 dias, sua produção caseira estará pronta, padronizada, congelada, precificada e com pedidos fechados.
            </p>
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="norma"
        titulo="Nota de Responsabilidade Operacional: Compromisso com a Execução Real"
        destaque="Sem Promessas Mágicas de Faturamento"
        mensagem="Este plano é um roteiro prático de organização da sua rotina produtiva. O objetivo é colocar o produto na rua e o negócio em movimento com segurança, sem promessas irresponsáveis de enriquecimento fácil ou fórmulas mágicas."
      />
    </section>
  </div>

  <!-- Prancha 4: Dias 1 e 2 - Escolher e Comprar -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">2.</span> Dias 1 e 2: Diagnóstico da Estrutura e Abastecimento
        </h2>
        <p class="secao-intro">
          A base do negócio começa na avaliação da cozinha doméstica e na compra cirúrgica dos primeiros insumos:
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3.5 flex-1 my-2">
        <!-- Dia 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">DIA 01 • ESCOLHER</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Diagnóstico & Mix</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Missão: Validar a Cozinha e os Sabores</h3>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 mt-2">
              <li>• <strong>Espaço Frio:</strong> Verifique se há espaço no congelador para 2 assadeiras planas.</li>
              <li>• <strong>Utensílios:</strong> Separe tábua atóxica, balança de precisão e faca afiada.</li>
              <li>• <strong>Grade Inicial:</strong> Defina 2 ou 3 sabores (Bovino, Frango c/ Bacon e Linguiça).</li>
            </ul>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[10.5px] text-amber-300 font-mono">
            Entregável: Bancada avaliada e sabores definidos.
          </div>
        </div>

        <!-- Dia 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-cyan-500/30 bg-cyan-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag cyan">DIA 02 • COMPRAR</span>
              <span class="text-xs text-cyan-400 font-mono font-bold">Matéria-Prima</span>
            </div>
            <h3 class="subcard-titulo text-xs text-cyan-300">Missão: Abastecimento Controlado do Lote Piloto</h3>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 mt-2">
              <li>• <strong>Carnes Frescas:</strong> Compre cortes resfriados no açougue parceiro (ex: 2kg bovino, 2kg frango, 1kg bacon).</li>
              <li>• <strong>Insumos:</strong> Palitos de bambu 25 cm, sacos gofrados a vácuo (0,18 mm) e etiquetas.</li>
              <li>• <strong>Temperos Secos:</strong> Alho em pó, cebola granulada, páprica defumada e sal refinado.</li>
            </ul>
          </div>
          <div class="mt-2 pt-2 border-t border-cyan-900/40 text-[10.5px] text-cyan-300 font-mono">
            Entregável: Insumos armazenados com notas fiscais salvas.
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Prancha 5: Dias 3 e 4 - Produzir, Padronizar e Congelar -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">3.</span> Dias 3 e 4: Manipulação, Padronização e Engenharia do Frio
        </h2>
        <p class="secao-intro">
          Transformando a carne limpa em espetinhos físicos e aplicando o pré-congelamento aberto:
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3.5 flex-1 my-2">
        <!-- Dia 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">DIA 03 • PRODUZIR</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Toalete & Espeto</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Missão: Corte, Marinada e Montagem</h3>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 mt-2">
              <li>• <strong>Palitos Secos:</strong> Use direto do pacote. Proibido molhar em água.</li>
              <li>• <strong>Toalete Rigorosa:</strong> Pese a carne bruta, retire aponeuroses e anote o peso limpo.</li>
              <li>• <strong>Corte a 90°:</strong> Fatie contra a fibra em cubos uniformes de 3 cm a 4 cm.</li>
              <li>• <strong>Marinada Seca:</strong> 20g da Base Seca + 20ml de óleo vegetal por kg limpo.</li>
              <li>• <strong>Montagem:</strong> 4 a 5 cubos no centro com reserva de 7 a 8 cm na base.</li>
            </ul>
          </div>
        </div>

        <!-- Dia 4 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-cyan-500/30 bg-cyan-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag cyan">DIA 04 • CONGELAR</span>
              <span class="text-xs text-cyan-400 font-mono font-bold">DNA & Estoque</span>
            </div>
            <h3 class="subcard-titulo text-xs text-cyan-300">Missão: Calibragem, Vácuo e Estocagem</h3>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 mt-2">
              <li>• <strong>Calibragem:</strong> Pese cada espeto na balança (meta: 100 g cravados).</li>
              <li>• <strong>Pré-Resfriamento:</strong> 30 a 60 min sob refrigeração (0°C a 5°C) antes de selar.</li>
              <li>• <strong>Vácuo Fracionado:</strong> Sacos de 15x30 cm (2 un) ou 18x30 cm (4 un).</li>
              <li>• <strong>Camada Fina:</strong> Congele em 1 nível por 6 horas antes de empilhar.</li>
            </ul>
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="alerta"
        titulo="Alerta Crítico: Afaste os Pacotes a Vácuo das Paredes com Gelo"
        destaque="Proteção da Solda Plástica"
        mensagem="Nunca encoste os sacos selados diretamente nas paredes internas do freezer que tenham camadas de gelo acumulado. A umidade funde o plástico à parede e rasga a embalagem ao puxar. Deixe sempre 2 cm de vão livre."
      />
    </section>
  </div>

  <!-- Prancha 6: Dias 5 e 6 - Precificar, Montar Cardápio e Divulgar -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">4.</span> Dias 5 e 6: Engenharia de Preços e Ativação de Vendas
        </h2>
        <p class="secao-intro">
          Transformando a produção congelada em oferta comercial e ativando os canais no WhatsApp:
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3.5 flex-1 my-2">
        <!-- Dia 5 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">DIA 05 • PRECIFICAÇÃO</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Custos & Cardápio</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Missão: Formação de Preços e Arte do Cardápio</h3>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 mt-2">
              <li>• <strong>Calculadora Oficial:</strong> Custo da carne limpa + palito + embalagem + taxa 7%.</li>
              <li>• <strong>Markup 1,8x:</strong> Margem de 44% a 50% de lucro líquido no preço de tabela.</li>
              <li>• <strong>Matriz de 3 Kits:</strong> Degustação (R$ 69), Família (R$ 119) e Galera (R$ 249).</li>
              <li>• <strong>Cardápio de 1 Página:</strong> Formato vertical para celular com ancoragem visual.</li>
            </ul>
          </div>
        </div>

        <!-- Dia 6 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">DIA 06 • DIVULGAR</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Canais & Contatos</span>
            </div>
            <h3 class="subcard-titulo text-xs text-emerald-300">Missão: Configuração do WhatsApp e Lançamento</h3>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 mt-2">
              <li>• <strong>WhatsApp Comercial:</strong> Foto nítida, bio oficial e atalhos rápidos salvos.</li>
              <li>• <strong>Status de Bastidores:</strong> Fotos da bancada e pesagem com chamada de ação.</li>
              <li>• <strong>Disparo Individual:</strong> Envio do script para 20 a 30 contatos próximos.</li>
              <li>• <strong>Zero Grupos Invasivos:</strong> Contato respeitoso um a um.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Prancha 7: Dia 7 - Primeiros Pedidos e Entregas -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">5.</span> DIA 7: Atendimento Ágil, Pedidos e Primeiras Entregas
        </h2>
        <p class="secao-intro">
          O grande dia da validação prática: transformar o interesse gerado nos Status em pacotes despachados e dinheiro em caixa:
        </p>
      </div>

      <div class="grid grid-cols-4 gap-2.5 flex-1 my-2">
        <div class="subcard-item p-3.5 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Etapa 01</span>
            <h3 class="subcard-titulo text-xs">Atendimento Ativo</h3>
            <p class="subcard-texto text-[11px]">
              Responda rápido pelo WhatsApp direcionando as dúvidas para o <strong>Kit Churrasco em Família</strong>.
            </p>
          </div>
        </div>

        <div class="subcard-item p-3.5 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Etapa 02</span>
            <h3 class="subcard-titulo text-xs">Registro de Pedidos</h3>
            <p class="subcard-texto text-[11px]">
              Anote nome, kit escolhido, endereço e horário na Ficha de Controle de Pedidos.
            </p>
          </div>
        </div>

        <div class="subcard-item p-3.5 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <span class="badge-tag emerald mb-1.5 inline-block">Etapa 03</span>
            <h3 class="subcard-titulo text-xs text-emerald-300">Confirmação Pix</h3>
            <p class="subcard-texto text-[11px]">
              Confirme o pagamento antecipado para garantir a reserva do lote no freezer.
            </p>
          </div>
        </div>

        <div class="subcard-item p-3.5 flex flex-col justify-between">
          <div>
            <span class="badge-tag emerald mb-1.5 inline-block">Etapa 04</span>
            <h3 class="subcard-titulo text-xs">Expedição Cuidadosa</h3>
            <p class="subcard-texto text-[11px]">
              Retire a carne minutos antes da entrega, usando sacola térmica ou caixa com placas de gelol.
            </p>
          </div>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-charcoal-950 border border-emerald-500/30 flex items-center justify-between">
        <div class="space-y-0.5 max-w-[80%]">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">O Marco da Primeira Semana: Ciclo Completo Validado</span>
          <p class="text-xs text-zinc-300">
            Você comprou a carne, limpou, temperou, padronizou, congelou a vácuo, precificou com margem real e colocou o dinheiro das primeiras vendas no caixa. O método está provado na sua casa!
          </p>
        </div>
        <span class="badge-tag emerald">Operação Validada</span>
      </div>
    </section>
  </div>

  <!-- Prancha 8: Tabela Técnica Oficial - Cronograma dos 7 Dias -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <TabelaTecnica
        titulo="Cronograma Oficial de Execução Acelerada — Os Primeiros 7 Dias"
        descricao="A esteira operacional diária para iniciar sua produção caseira com clareza absoluta:"
        colunas={["Dia", "Missão Central", "Atividade Prática Principal", "Insumos & Ferramentas", "Entregável do Dia"]}
        largurasColunas={["10%", "15%", "35%", "20%", "20%"]}
        linhas={[
          ["Dia 1", "Escolher", "Diagnóstico da cozinha, balança e definição dos 3 sabores", "Checklist de Utensílios", "Bancada aprovada e mix fechado"],
          ["Dia 2", "Comprar", "Compra das carnes frescas no açougue, palitos e temperos", "Lista de Compras Inicial", "Insumos guardados e notas salvas"],
          ["Dia 3", "Produzir", "Toalete, cubagem a 90°, aplicação da Base Seca e montagem", "Ficha de Produção", "Espetinhos montados na bancada"],
          ["Dia 4", "Congelar", "Calibragem (100g), pré-resfriamento, vácuo e camada fina", "Sacos de 0,18mm + Seladora", "Estoque congelado e rotulado"],
          ["Dia 5", "Precificar", "Cálculo do custo da carne limpa, markup 1,8x e cardápio", "Calculadora de Custos", "Cardápio digital de 1 página pronto"],
          ["Dia 6", "Divulgar", "Configuração do WhatsApp comercial e envio para 25 contatos", "Script Anti-Spam", "Rede de contatos ciente do estoque"],
          ["Dia 7", "Vender", "Atendimento ativo, fechamento no Pix e entregas programadas", "Ficha de Pedidos + Caixa", "Primeiras vendas faturadas"]
        ]}
        destaqueIndice={6}
        rodape="Diretriz: Cumpra um dia de cada vez. A consistência diária elimina a ansiedade e gera resultados operacionais sólidos."
      />
    </div>
  </div>

  <!-- Prancha 9: Seção 9 - Checklist Consolidado do Plano 7 Dias -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <ChecklistOperacional
        titulo="Checklist Consolidado de Auditoria do Plano 7 Dias"
        subtitulo="Marque cada dia após a conclusão integral das atividades de bancada e venda:"
        itens={[
          { texto: "DIA 1 — ESCOLHER: Estrutura doméstica avaliada, utensílios separados e 3 sabores definidos.", obrigatorio: true, detalhe: "Bancada limpa e facas afiadas." },
          { texto: "DIA 2 — COMPRAR: Carnes frescas resfriadas, palitos de bambu, sacos e condimentos comprados.", obrigatorio: true, detalhe: "Notas guardadas para cálculo de custos." },
          { texto: "DIA 3 — PRODUZIR: Carne limpa de aparas, cubos cortados contra a fibra e espetos montados.", obrigatorio: true, detalhe: "Palitos secos e reserva de 7 cm respeitada." },
          { texto: "DIA 4 — CONGELAR: Unidades pesadas em 100 g, embaladas a vácuo e congeladas em camada fina.", obrigatorio: true, detalhe: "Etiquetas preenchidas com validade responsável." },
          { texto: "DIA 5 — PRECIFICAÇÃO: Custos reais inseridos na calculadora, kits criados e cardápio montado.", obrigatorio: true, detalhe: "Markup 1,8x com margem líquida acima de 40%." },
          { texto: "DIA 6 — DIVULGAR: WhatsApp ajustado, fotos nos Status e script enviado para contatos próximos.", obrigatorio: true, detalhe: "Lançamento respeitoso e individual." },
          { texto: "DIA 7 — VENDER: Atendimentos concluídos, pedidos registrados e primeiras entregas cumpridas.", obrigatorio: true, detalhe: "Dinheiro no caixa e ciclo do método validado." }
        ]}
      />
    </div>
  </div>
</EbookLayout>
