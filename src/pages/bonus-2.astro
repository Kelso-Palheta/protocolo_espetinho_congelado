---
import EbookLayout from '../layouts/EbookLayout.astro';
import VisualBlock from '../components/VisualBlock.astro';
import CalloutAlerta from '../components/CalloutAlerta.astro';
import TabelaTecnica from '../components/TabelaTecnica.astro';
import ChecklistOperacional from '../components/ChecklistOperacional.astro';
import imgRecompra from '../assets/illustrations/bonus-2-recompra.png';
import imgCapa from '../assets/illustrations/capa-bonus-2.png';
---

<EbookLayout
  title="Bônus 2 — Protocolo da Recompra: Clientes Recorrentes"
  category="bonus"
  chapterNumber="02"
  chapterTitle="BÔNUS 2 — PROTOCOLO DA RECOMPRA"
  chapterSubtitle="Como Construir Clientes Recorrentes e Previsibilidade Semanal de Caixa"
  imagemCapa={imgCapa.src}
  prevLink={{ title: "Bônus 1: Delivery", href: "/bonus-1" }}
  nextLink={{ title: "Bônus 3: Expansão", href: "/bonus-3" }}
>
  <!-- Prancha 2: Bloco Visual Hero (Ocupação Nobre de 90% da Página) -->
  <div class="prancha">
    <VisualBlock
      stepNumber="B2"
      badge="Retenção & LTV"
      title="A Máquina Silenciosa de Pedidos Recorrentes"
      subtitle="Transformando uma compra única em um cliente que pede a cada 15 dias"
      description="Buscar novos clientes todo dia é exaustivo e caro. O cliente que já comprou, assou os espetinhos no fim de semana e comprovou a maciez da carne é o ativo mais valioso da sua operação. Com uma régua simples de pós-venda e histórico de preferências, uma base de 20 clientes fiéis sustenta sua produção semanal com custo zero de aquisição."
      tip="Nunca mande promoções todo dia. O segredo da recompra é o timing: pergunte a opinião dele 48h após o consumo (terça-feira) e abra a agenda de reposição na quinta-feira de manhã."
      imageSrc={imgRecompra.src}
      imageAlt="Caderno de cadastro de clientes com pedidos de recompra de espetinhos sobre bancada"
      imagePosition="left"
    />
  </div>

  <!-- Prancha 3: Seção 1 - A Lógica da Recompra no Mercado de Alimentação -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-2">
        <h2 class="secao-titulo">
          <span class="text-amber-500">1.</span> A Lógica da Recompra no Mercado de Alimentação
        </h2>
        <p class="secao-intro">
          O erro comum do iniciante é gastar 100% da energia buscando clientes novos. Conquistar uma pessoa desconhecida exige quebra de desconfiança e tempo. Quem já comprou e elogiou seu espetinho já confia na sua entrega:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Pilar 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Pilar 01</span>
              <span class="text-xs text-zinc-400 font-mono">Ciclo Natural</span>
            </div>
            <h3 class="subcard-titulo text-xs">Consumo Semanal / Quinzenal</h3>
            <p class="subcard-texto text-[11px] mb-2">
              A carne consumida no churrasco de domingo ou no jantar prático da família precisa ser reposta no freezer para a semana seguinte.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-charcoal-800 text-[10.5px] text-amber-400 font-mono">
            Demanda contínua que nunca cessa.
          </div>
        </div>

        <!-- Pilar 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Pilar 02</span>
              <span class="text-xs text-amber-400 font-mono font-bold">CAC Zero</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Custo Zero de Aquisição</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Vender novamente para a sua própria lista de contatos não custa nem um centavo em publicidade, tráfego ou anúncios pagos.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[10.5px] text-emerald-300 font-mono">
            Margem líquida 100% preservada no bolso.
          </div>
        </div>

        <!-- Pilar 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Pilar 03</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Estabilidade</span>
            </div>
            <h3 class="subcard-titulo text-xs">Previsibilidade Financeira</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Com apenas <strong>15 a 25 clientes recorrentes</strong> comprando quinzenalmente, sua produção semanal já nasce vendida antes mesmo de cortar a carne.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-charcoal-800 text-[10.5px] text-zinc-300 font-mono">
            Fim do desespero de não saber quanto vai faturar.
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="norma"
        titulo="Regra Inegociável da Recompra: O Pedido Nunca Morre na Entrega"
        destaque="Construção de Relacionamento Comercial Duradouro"
        mensagem="Ao entregar o pacote, não considere o processo encerrado. O cliente que volta a comprar a cada duas semanas vale no mínimo R$ 2.500,00 por ano no faturamento da sua cozinha. Trate cada comprador como um cliente fixo de longo prazo."
      />
    </section>
  </div>

  <!-- Prancha 4: Seção 2 - A Régua de Pós-Venda (O Timing Correto da Mensagem) -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">2.</span> A Régua de Pós-Venda: O Timing Exato do Contato
        </h2>
        <p class="secao-intro">
          Mandar mensagens promocionais todo dia é o caminho mais rápido para ser bloqueado no WhatsApp. A abordagem pós-venda possui dois momentos estratégicos:
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3.5 flex-1 my-2">
        <!-- Janela 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Janela 01 (24h a 48h)</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Segunda ou Terça</span>
            </div>
            <h3 class="subcard-titulo text-sm text-zinc-100">Pesquisa de Satisfação & Prova Social</h3>
            <p class="subcard-texto text-xs mb-3 text-zinc-300">
              Se o cliente retirou ou recebeu os espetinhos no fim de semana, o momento de perguntar a opinião é no início da semana:
            </p>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 font-mono">
              <li>• Coletar feedback real de maciez, sal e sabor.</li>
              <li>• Demonstrar cuidado e zelo profissional.</li>
              <li>• Coletar depoimentos em texto para postar nos Status.</li>
            </ul>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[11px] text-amber-300 font-semibold">
            Gera empatia profunda e desarma qualquer insegurança.
          </div>
        </div>

        <!-- Janela 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Janela 02 (Antecipação)</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Quinta-Feira</span>
            </div>
            <h3 class="subcard-titulo text-sm text-zinc-100">Abertura Exclusiva de Encomendas</h3>
            <p class="subcard-texto text-xs mb-3 text-zinc-300">
              Quinta-feira é o dia em que as famílias começam a planejar o cardápio e o lazer do fim de semana:
            </p>
            <ul class="lista-topicos text-[11px] gap-1.5 text-zinc-300 font-mono">
              <li>• Avisar que os lotes frescos estão sendo montados.</li>
              <li>• Dar prioridade de escolha para quem já é cliente da casa.</li>
              <li>• Lembrar que o estoque do freezer dele pode estar acabando.</li>
            </ul>
          </div>
          <div class="mt-2 pt-2 border-t border-emerald-900/40 text-[11px] text-emerald-300 font-semibold">
            Transforma o desejo de churrasco em pedido reservado.
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="alerta"
        titulo="Alerta de Invasão: Proibido Mensagens Coletivas no Fim de Semana"
        destaque="Comunicação Individual e Cirúrgica"
        mensagem="Nunca mande mensagens aos domingos perguntando se a pessoa quer comprar. Respeite os momentos de lazer. As compras de carne congelada são planejadas previamente de quinta a sexta-feira."
      />
    </section>
  </div>

  <!-- Prancha 5: Seção 3 - O Calendário Semanal de Recompra -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">3.</span> O Calendário Semanal de Recompra (Rotina de 5 Dias)
        </h2>
        <p class="secao-intro">
          Para manter sua carteira de clientes aquecida sem esforço braçal excessivo, execute esta sequência estruturada de segunda a sexta-feira:
        </p>
      </div>

      <div class="grid grid-cols-5 gap-2.5 flex-1 my-2">
        <!-- Seg -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Segunda</span>
            <h3 class="subcard-titulo text-xs">Pós-Venda</h3>
            <p class="subcard-texto text-[11px]">
              Dispare a mensagem de pesquisa de satisfação para os compradores do último fim de semana.
            </p>
          </div>
        </div>

        <!-- Ter -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Terça</span>
            <h3 class="subcard-titulo text-xs">Organização</h3>
            <p class="subcard-texto text-[11px]">
              Anote preferências na ficha de clientes e ajuste eventuais detalhes de tempero ou corte no novo lote.
            </p>
          </div>
        </div>

        <!-- Qua -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Quarta</span>
            <h3 class="subcard-titulo text-xs">Filtro Ativo</h3>
            <p class="subcard-texto text-[11px]">
              Liste quais clientes completam 15 a 20 dias sem pedir para enviar lembrete de reposição na quinta.
            </p>
          </div>
        </div>

        <!-- Qui -->
        <div class="subcard-item p-3 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Quinta</span>
            <h3 class="subcard-titulo text-xs text-amber-300">Lote Exclusivo</h3>
            <p class="subcard-texto text-[11px]">
              Envie mensagem personalizada avisando sobre a abertura antecipada de encomendas para clientes VIP.
            </p>
          </div>
        </div>

        <!-- Sex -->
        <div class="subcard-item p-3 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <span class="badge-tag emerald mb-1.5 inline-block">Sexta</span>
            <h3 class="subcard-titulo text-xs text-emerald-300">Fechamento</h3>
            <p class="subcard-texto text-[11px]">
              Confirme os horários de retirada e entregas agendadas no fim de semana com comprovantes Pix.
            </p>
          </div>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-charcoal-950 border border-charcoal-800 flex items-center justify-between">
        <span class="text-xs text-zinc-300">
          <strong>Previsibilidade Operacional:</strong> Com esse calendário, na quinta-feira à tarde você já sabe com precisão quantos quilos de carne comprar e desossar na sexta-feira.
        </span>
        <span class="badge-tag emerald">Zero Desperdício de Carne</span>
      </div>
    </section>
  </div>

  <!-- Prancha 6: Seção 4 - Estratégia para Gerar Indicações Locais (Boca a Boca Programado) -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">4.</span> Estratégia para Gerar Indicações Locais (Boca a Boca Programado)
        </h2>
        <p class="secao-intro">
          Clientes satisfeitos adoram indicar coisas boas para amigos e familiares, mas esquecem de fazer espontaneamente. Conduza o processo com 3 táticas ativas:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Tática 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Tática 01</span>
              <span class="text-xs text-zinc-400 font-mono">Timing de Ouro</span>
            </div>
            <h3 class="subcard-titulo text-xs">No Pico do Elogio</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Nunca peça indicação no portão ao entregar o pacote.
            </p>
            <p class="text-[10.5px] text-zinc-400">
              O momento exato é imediatamente após o cliente responder elogiando a maciez e o sabor da carne na mensagem de terça-feira.
            </p>
          </div>
        </div>

        <!-- Tática 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Tática 02</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Incentivo</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Benefício Real e Concreto</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Ofereça vantagem palpável para a próxima compra dele:
            </p>
            <div class="p-2 rounded-lg bg-charcoal-900 border border-charcoal-800 text-[10.5px] text-zinc-200 font-mono italic">
              "Se um amigo indicado comprar um kit, você ganha 1 pacote extra de 5 espetinhos de linguiça ou R$ 15 de desconto no seu próximo pedido!"
            </div>
          </div>
        </div>

        <!-- Tática 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Tática 03</span>
              <span class="text-xs text-emerald-400 font-mono">Geografia</span>
            </div>
            <h3 class="subcard-titulo text-xs">O Efeito Condomínio / Rua</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Ao entregar em uma rua ou condomínio fechado, pergunte com gentileza se o cliente pode compartilhar o cardápio no grupo do prédio ou vizinhos.
            </p>
            <p class="text-[10.5px] text-emerald-300 font-mono">
              Facilita entregas em lote no mesmo endereço físico.
            </p>
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="norma"
        titulo="O Poder da Indicação Pessoal: A Venda Mais Fácil da Sua Operação"
        destaque="Confiança Transferida Imediata"
        mensagem="Quando um amigo recomenda seu espetinho a outro amigo, o cliente indicado compra sem pedir desconto e sem duvidar da qualidade. Cada cliente satisfeito tem potencial para trazer de 2 a 3 novos compradores fixos."
      />
    </section>
  </div>

  <!-- Prancha 7: Seção 5 - Scripts Prontos de Comunicação para Recompra -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">5.</span> Scripts Prontos de Comunicação para Recompra no WhatsApp
        </h2>
        <p class="secao-intro">
          Copie, personalize e utilize estes textos oficiais para gerenciar o relacionamento com sua base ativa:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-1">
        <!-- Script 1 -->
        <div class="subcard-item p-3.5 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1 inline-block">Script 01 • Terça 48h</span>
            <h3 class="subcard-titulo text-xs">Pesquisa Pós-Consumo</h3>
            <div class="p-2.5 rounded-lg bg-charcoal-900 border border-charcoal-800 text-[10.5px] text-zinc-300 italic space-y-1 mt-1 leading-relaxed">
              <p>"Olá, [Nome]! Tudo bem por aí?</p>
              <p>Passando rapidinho para saber como foi o churrasco no fim de semana! Os espetinhos estavam do seu agrado? A maciez e o tempero atenderam sua expectativa?</p>
              <p class="text-amber-300">Sua opinião é fundamental para a gente manter o padrão artesanal!"</p>
            </div>
          </div>
        </div>

        <!-- Script 2 -->
        <div class="subcard-item p-3.5 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <span class="badge-tag amber mb-1 inline-block">Script 02 • Pós-Elogio</span>
            <h3 class="subcard-titulo text-xs text-amber-300">Pedido de Indicação</h3>
            <div class="p-2.5 rounded-lg bg-charcoal-900 border border-charcoal-800 text-[10.5px] text-zinc-300 italic space-y-1 mt-1 leading-relaxed">
              <p>"Fico muito feliz que tenha gostado, [Nome]! É gratificante ouvir isso.</p>
              <p>Se tiver algum amigo ou parente que também adora praticidade e churrasco de qualidade, compartilhe nosso contato!</p>
              <p class="text-emerald-400 font-semibold">Se algum amigo fechar pedido por sua indicação, faço questão de mandar um brinde especial no seu próximo kit!"</p>
            </div>
          </div>
        </div>

        <!-- Script 3 -->
        <div class="subcard-item p-3.5 flex flex-col justify-between">
          <div>
            <span class="badge-tag emerald mb-1 inline-block">Script 03 • Quinta 20 dias</span>
            <h3 class="subcard-titulo text-xs">Reativação de Estoque</h3>
            <div class="p-2.5 rounded-lg bg-charcoal-900 border border-charcoal-800 text-[10.5px] text-zinc-300 italic space-y-1 mt-1 leading-relaxed">
              <p>"Olá, [Nome]! Como você está?</p>
              <p>Percebi que faz alguns dias desde a sua última encomenda e imaginei que o estoque do seu freezer já deve estar no finalzinho!</p>
              <p>Estamos montando os lotes com os sabores que você mais gosta ([ex: Alcatra e Medalhão]).</p>
              <p class="text-amber-400 font-semibold">Quer que eu já reserve um kit para seu fim de semana?"</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Prancha 8: Seção 6 - Modelo de Controle e Cadastro de Clientes (Tabela Técnica) -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <TabelaTecnica
        titulo="Ficha de Cadastro, Histórico e Frequência de Recompra"
        descricao="Mantenha este registro atualizado para personalizar o atendimento e antecipar as compras de cada cliente:"
        colunas={["Nome do Cliente", "WhatsApp", "Bairro", "Sabores Favoritos", "Última Compra", "Frequência", "Próximo Contato"]}
        largurasColunas={["17%", "14%", "14%", "25%", "10%", "10%", "10%"]}
        linhas={[
          ["Marcos Oliveira", "(11) 98765-4321", "Jardim América", "Kit Família (Alcatra + Medalhão s/ pimenta)", "05/09", "Quinzenal", "Quinta (17/09)"],
          ["Carla Rodrigues", "(11) 97123-8899", "Bela Vista", "Kit Degustação Casal (Adora Queijo Coalho)", "06/09", "Semanal", "Quinta (10/09)"],
          ["Roberto Santos", "(11) 99456-1122", "Parque Sul", "Pacote Galera (Espetos bovinos bem passados)", "29/08", "Mensal", "Quinta (24/09)"],
          ["Juliana Mendes", "(11) 98877-3344", "Centro", "Pacotes Fechados Frango c/ Bacon (Só peito)", "05/09", "Quinzenal", "Quinta (17/09)"],
          ["Felipe Barbosa", "(11) 97654-2211", "Jardim Flores", "Kit Família + Linguiça Toscana picante", "06/09", "Quinzenal", "Quinta (17/09)"]
        ]}
        destaqueIndice={0}
        rodape="Dica de Ouro: Citar o sabor favorito do cliente no momento da mensagem gera conexão emocional imediata e taxa de resposta acima de 85%."
      />
    </div>
  </div>

  <!-- Prancha 9: Seção 7 - Checklist Prático do Protocolo da Recompra -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <ChecklistOperacional
        titulo="Checklist Prático de Execução do Protocolo da Recompra"
        subtitulo="Auditoria semanal de retenção e acompanhamento da base de clientes:"
        itens={[
          { texto: "Mensagem de pesquisa pós-venda disparada para todos os compradores até terça-feira.", obrigatorio: true, detalhe: "Coleta de feedbacks e garantia de satisfação no consumo." },
          { texto: "Respostas e elogios registrados no controle de histórico de preferências de cada cliente.", obrigatorio: true, detalhe: "Base de dados para personalizar o próximo contato de reposição." },
          { texto: "Solicitação de indicação com brinde enviada imediatamente após a recepção do elogio.", obrigatorio: true, detalhe: "Ativação do boca a boca programado no pico da satisfação." },
          { texto: "Clientes inativos há mais de 15 a 20 dias listados na quarta e abordados na quinta-feira.", obrigatorio: true, detalhe: "Reativação do estoque do freezer antes que comprem em supermercados." },
          { texto: "Preferências de cortes e temperos consultadas antes de disparar a oferta semanal.", obrigatorio: true, detalhe: "Atendimento consultivo que nenhum grande açougue industrial replica." }
        ]}
      />
    </div>
  </div>
</EbookLayout>
