---
import EbookLayout from '../layouts/EbookLayout.astro';
import VisualBlock from '../components/VisualBlock.astro';
import CalloutAlerta from '../components/CalloutAlerta.astro';
import TabelaTecnica from '../components/TabelaTecnica.astro';
import ChecklistOperacional from '../components/ChecklistOperacional.astro';
import imgCrescimento from '../assets/illustrations/bonus-3-crescimento.png';
import imgCapa from '../assets/illustrations/capa-bonus-3.png';
---

<EbookLayout
  title="Bônus 3 — Protocolo do Crescimento: Reinvestimento e Expansão"
  category="bonus"
  chapterNumber="03"
  chapterTitle="BÔNUS 3 — PROTOCOLO DO CRESCIMENTO"
  chapterSubtitle="Reinvestimento Consciente, Separação de Caixa e Escala sem Endividamento"
  imagemCapa={imgCapa.src}
  prevLink={{ title: "Bônus 2: Recompra", href: "/bonus-2" }}
  nextLink={{ title: "Bônus 4: Plano 7 Dias", href: "/bonus-4" }}
>
  <!-- Prancha 2: Bloco Visual Hero (Ocupação Nobre de 90% da Página) -->
  <div class="prancha">
    <VisualBlock
      stepNumber="B3"
      badge="Finanças & Escala"
      title="A Disciplina Financeira da Expansão Consciente"
      subtitle="Como dobrar a produção caseira reinvestindo o próprio lucro"
      description="O erro fatal de quem fatura na cozinha é misturar o caixa da operação com os boletos da casa. O crescimento sólido nasce da separação rígida: 50% para comprar carne limpa e insumos, 20% para a reserva de novos maquinários e 30% de remuneração pessoal limpa no bolso. É o lucro retido que financia o segundo freezer sem gerar dívidas."
      tip="O maior limitador do seu faturamento caseiro não é a tábua de corte, mas a capacidade em litros do seu freezer. Quando o congelador atingir 80% de ocupação toda semana, adquira um freezer horizontal compacto."
      imageSrc={imgCrescimento.src}
      imageAlt="Freezer horizontal organizado com lotes a vácuo e caderno financeiro de expansão"
      imagePosition="right"
    />
  </div>

  <!-- Prancha 3: Seção 1 - A Divisão do Dinheiro: Capital de Giro vs. Retirada Pessoal -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-2">
        <h2 class="secao-titulo">
          <span class="text-amber-500">1.</span> A Divisão do Dinheiro: Capital de Giro vs. Retirada Pessoal
        </h2>
        <p class="secao-intro">
          O erro que quebra operações caseiras é tratar cada Pix recebido como lucro livre. Ao gastar o valor integral, falta dinheiro na semana seguinte para comprar carne fresca no açougue parceiro.
        </p>
      </div>

      <div class="destaque-tag">
        A REGRA DA DIVISÃO RÍGIDA DO FATURAMENTO (A FÓRMULA 50 / 20 / 30)
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Parcela 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">50% do Total</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Inviolável</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Capital de Giro (Reposição)</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Pertence exclusivamente à compra do próximo lote de carne limpa, palitos de bambu, sacos a vácuo e condimentos.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[10.5px] text-amber-300 font-mono">
            Retorna imediatamente para a conta da operação.
          </div>
        </div>

        <!-- Parcela 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-cyan-500/30 bg-cyan-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag cyan">20% do Líquido</span>
              <span class="text-xs text-cyan-400 font-mono font-bold">Motor</span>
            </div>
            <h3 class="subcard-titulo text-xs text-cyan-300">Fundo de Expansão e Reserva</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Fundo destinado à compra do segundo freezer horizontal, seladora profissional e caixas térmicas sem dívidas.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-cyan-900/40 text-[10.5px] text-cyan-300 font-mono">
            Acumula o capital para subir de nível operacional.
          </div>
        </div>

        <!-- Parcela 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">30% do Total</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Pró-Labore</span>
            </div>
            <h3 class="subcard-titulo text-xs text-emerald-300">Retirada Pessoal Livre</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Sua remuneração líquida pelo trabalho exercido. Pode ser transferida para a sua conta pessoal sem desfalcar o giro.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-emerald-900/40 text-[10.5px] text-emerald-300 font-mono">
            Salário previsível e seguro fruto do seu negócio.
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="perigo"
        titulo="Alerta Financeiro: Abra uma Chave Pix Exclusiva para o Negócio"
        destaque="Zero Mistura com Finanças Pessoais"
        mensagem="Mesmo trabalhando em casa, nunca use a conta corrente da família para receber pedidos de clientes. Crie uma conta digital gratuita exclusiva para a produção de espetinhos. Essa separação impede o desvio inconsciente do capital de giro."
      />
    </section>
  </div>

  <!-- Prancha 4: Seção 2 - Análise da Curva ABC: Os Produtos que Sustentam a Operação -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">2.</span> Análise da Curva ABC: Os Produtos que Sustentam o Negócio
        </h2>
        <p class="secao-intro">
          Nem todo sabor vende na mesma velocidade ou deixa a mesma margem. Produzir sabores trabalhosos de baixo giro consome tempo e trava o freezer:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Categoria A -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Curva A (70% a 80%)</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Carros-Chefe</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Bovino Tradicional & Medalhão</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Responsáveis pela maior fatia do faturamento semanal.
            </p>
            <p class="text-[10.5px] text-zinc-300 font-mono">
              Nunca podem faltar no estoque. Devem ter a produção prioritária na quarta e quinta-feira.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[10.5px] text-amber-300 font-mono">
            Giro garantido em 100% dos pedidos.
          </div>
        </div>

        <!-- Categoria B -->
        <div class="subcard-item p-4 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Curva B (15% a 20%)</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Margem Alta</span>
            </div>
            <h3 class="subcard-titulo text-xs text-emerald-300">Linguiça Toscana & Queijo Coalho</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Itens com custo de preparo baixíssimo que alavancam o lucro dos combos.
            </p>
            <p class="text-[10.5px] text-zinc-300 font-mono">
              Produzidos em lotes rápidos para acompanhar os kits da semana.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-emerald-900/40 text-[10.5px] text-emerald-300 font-mono">
            As maiores margens percentuais da tabela.
          </div>
        </div>

        <!-- Categoria C -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag zinc">Curva C (&lt; 10%)</span>
              <span class="text-xs text-zinc-400 font-mono">Sob Encomenda</span>
            </div>
            <h3 class="subcard-titulo text-xs">Cortes Nobres & Especiais</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Picanha, cordeiro ou espetos intercalados com legumes de toalete demorado.
            </p>
            <p class="text-[10.5px] text-rose-400 font-mono">
              Produção estritamente sob encomenda antecipada para não empatar dinheiro no congelador.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-charcoal-800 text-[10.5px] text-zinc-400 font-mono">
            Zero carne cara estagnada no freezer.
          </div>
        </div>
      </div>

      <div class="p-3 rounded-xl bg-charcoal-950 border border-charcoal-800 flex items-center justify-between">
        <span class="text-xs text-zinc-300">
          <strong>Otimização de Espaço Físico:</strong> Priorize sempre os produtos da Curva A e B no freezer doméstico. Estoque parado é dinheiro imobilizado perdendo qualidade.
        </span>
        <span class="badge-tag amber">Foco no Giro</span>
      </div>
    </section>
  </div>

  <!-- Prancha 5: Seção 3 - O Plano de Equipamentos: A Ordem Correta de Aquisição -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">3.</span> O Plano de Equipamentos: A Ordem Correta de Aquisição
        </h2>
        <p class="secao-intro">
          O crescimento da cozinha deve ser gradual e financiado 100% pelo lucro retido, sem empréstimos bancários. Siga esta ordem de prioridades:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Nível 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Prioridade 01</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Espaço Frio</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Segundo Freezer Horizontal (150L a 200L)</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Seu maior gargalo de faturamento não é a bancada, é o freezer cheio.
            </p>
            <p class="text-[10.5px] text-zinc-300">
              Quando a geladeira estiver com 80% de lotação semanal, adquira um freezer compacto. Ele dobra sua capacidade de entrega imediatamente.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[10.5px] text-amber-300 font-mono">
            Investimento: R$ 1.200 a R$ 1.600.
          </div>
        </div>

        <!-- Nível 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-cyan-500/30 bg-cyan-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag cyan">Prioridade 02</span>
              <span class="text-xs text-cyan-400 font-mono font-bold">Apresentação</span>
            </div>
            <h3 class="subcard-titulo text-xs text-cyan-300">Seladora a Vácuo de Bancada</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Após garantir espaço térmico, adquira uma máquina com barra de solda de 28 a 30 cm.
            </p>
            <p class="text-[10.5px] text-zinc-300">
              Elimina o risco de queimaduras de frio, eleva o padrão visual para nível de supermercado gourmet e estende a conservação.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-cyan-900/40 text-[10.5px] text-cyan-300 font-mono">
            Investimento: R$ 350 a R$ 600.
          </div>
        </div>

        <!-- Nível 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Prioridade 03</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Produtividade</span>
            </div>
            <h3 class="subcard-titulo text-xs">Moedor / Cortador Semiprofissional</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Equipamentos para acelerar a cubagem e permitir a produção de kaftas e hambúrgueres a partir das aparas limpas.
            </p>
            <p class="text-[10.5px] text-zinc-300">
              Aproveitamento de 100% da matéria-prima com custo zero de carne.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-charcoal-800 text-[10.5px] text-emerald-300 font-mono">
            Investimento: R$ 400 a R$ 800.
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="norma"
        titulo="Princípio do Autofinanciamento: Equipamento Novo Só com Lucro Acumulado"
        destaque="Segurança Financeira Familiar"
        mensagem="Nunca parcele maquinário no cartão pessoal antes de ter as primeiras vendas confirmadas. Deixe a reserva de 20% do lucro líquido acumular no fundo de expansão até atingir o valor à vista do equipamento."
      />
    </section>
  </div>

  <!-- Prancha 6: Seção 4 - Gestão de Tempo e Capacidade Produtiva em Blocos -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">4.</span> Gestão de Tempo e Capacidade Produtiva em Blocos
        </h2>
        <p class="secao-intro">
          Aumentar a produção não exige passar o dia inteiro na cozinha. O segredo da escala caseira é organizar a semana em dias temáticos especializados:
        </p>
      </div>

      <div class="grid grid-cols-5 gap-2.5 flex-1 my-2">
        <!-- Seg/Ter -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag zinc mb-1.5 inline-block">Seg & Ter</span>
            <h3 class="subcard-titulo text-xs">Pós-Venda & Compras</h3>
            <p class="subcard-texto text-[11px]">
              Pesquisa com clientes, compras no açougue parceiro e higienização pesada dos utensílios.
            </p>
          </div>
        </div>

        <!-- Qua -->
        <div class="subcard-item p-3 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Quarta</span>
            <h3 class="subcard-titulo text-xs text-amber-300">O Dia do Corte</h3>
            <p class="subcard-texto text-[11px]">
              Toalete de todas as peças, cubagem padronizada contra a fibra e aplicação de marinadas secas.
            </p>
          </div>
        </div>

        <!-- Qui -->
        <div class="subcard-item p-3 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Quinta</span>
            <h3 class="subcard-titulo text-xs text-amber-300">Montagem & IQF</h3>
            <p class="subcard-texto text-[11px]">
              Espetamento em fluxo contínuo na bancada, controle de peso e abastecimento das bandejas de congelamento.
            </p>
          </div>
        </div>

        <!-- Sex -->
        <div class="subcard-item p-3 flex flex-col justify-between border-cyan-500/30 bg-cyan-950/10">
          <div>
            <span class="badge-tag cyan mb-1.5 inline-block">Sexta</span>
            <h3 class="subcard-titulo text-xs text-cyan-300">Vácuo & Expedição</h3>
            <p class="subcard-texto text-[11px]">
              Ensacamento dos produtos duros ("pedrada"), rotulagem adesiva e início das entregas da tarde.
            </p>
          </div>
        </div>

        <!-- Sáb/Dom -->
        <div class="subcard-item p-3 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <span class="badge-tag emerald mb-1.5 inline-block">Sáb & Dom</span>
            <h3 class="subcard-titulo text-xs text-emerald-300">Entregas & Desejo</h3>
            <p class="subcard-texto text-[11px]">
              Cumprimento de rotas de delivery programado e atendimento rápido de pedidos de última hora.
            </p>
          </div>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-charcoal-950 border border-charcoal-800 flex items-center justify-between">
        <span class="text-xs text-zinc-300">
          <strong>Capacidade Real de Bancada:</strong> Trabalhando em blocos temáticos de 3 a 4 horas por dia, uma única pessoa produz com calma de <strong>300 a 400 espetinhos por semana</strong> em casa, gerando faturamento de R$ 2.400 a R$ 3.200 semanais.
        </span>
        <span class="badge-tag emerald">300 a 400 un/semana</span>
      </div>
    </section>
  </div>

  <!-- Prancha 7: Seção 5 - Parcerias Locais B2B: Expandindo Além do Consumidor Final -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">5.</span> Parcerias Locais B2B: Expandindo Além do Consumidor Final
        </h2>
        <p class="secao-intro">
          Quando a rotina estiver dominada e houver capacidade ociosa no freezer, abra novos canais de fornecimento local mantendo o formato congelado:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Canal 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Canal 01</span>
              <span class="text-xs text-amber-400 font-mono font-bold">Bebidas & Gelo</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Distribuidoras & Depósitos de Cerveja</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Quem compra carvão, gelo e cerveja quer resolver a carne no mesmo local.
            </p>
            <p class="text-[10.5px] text-zinc-300">
              Forneça pacotes lacrados a vácuo com desconto de atacado para o comerciante revender com margem de 20% no freezer dele.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 text-[10.5px] text-amber-300 font-mono">
            Venda recorrente de alto volume.
          </div>
        </div>

        <!-- Canal 2 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-cyan-500/30 bg-cyan-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag cyan">Canal 02</span>
              <span class="text-xs text-cyan-400 font-mono font-bold">Vizinhança</span>
            </div>
            <h3 class="subcard-titulo text-xs text-cyan-300">Pequenas Mercearias & Mercadinhos</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Mercadinhos de bairro que não têm açougue adoram produtos embalados e rotulados.
            </p>
            <p class="text-[10.5px] text-zinc-300">
              Apresente sua linha padronizada com rotulagem sanitária transparente para pontos de venda próximos.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-cyan-900/40 text-[10.5px] text-cyan-300 font-mono">
            Ponto comercial sem custo de aluguel.
          </div>
        </div>

        <!-- Canal 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between border-emerald-500/30 bg-emerald-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Canal 03</span>
              <span class="text-xs text-emerald-400 font-mono font-bold">Grandes Lotes</span>
            </div>
            <h3 class="subcard-titulo text-xs text-emerald-300">Eventos Corporativos & Festas</h3>
            <p class="subcard-texto text-[11px] mb-2">
              Fornecimento de lotes de 50 a 150 espetinhos para aniversários, empresas e confraternizações.
            </p>
            <p class="text-[10.5px] text-zinc-300">
              Pagamento com 50% de sinal no Pix antecipado para bancar as carnes e saldo na entrega pontual.
            </p>
          </div>
          <div class="mt-2 pt-2 border-t border-emerald-900/40 text-[10.5px] text-emerald-300 font-mono">
            Injeção rápida de caixa no negócio.
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="norma"
        titulo="Diretriz de Consignação: Aceite Apenas em Pontos de Altíssima Confiança"
        destaque="Segurança da Mercadoria Congelada"
        mensagem="Ao colocar produtos em freezers de terceiros, verifique se o equipamento deles não desliga à noite e mantenha o acerto financeiro semanal. O produto congelado a vácuo é um ativo valioso."
      />
    </section>
  </div>

  <!-- Prancha 8: Seção 6 - Modelo de Painel Simples de Resultados Mensais (Tabela Técnica) -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <TabelaTecnica
        titulo="Painel Mensal de Fechamento de Caixa e Destinação de Lucro"
        descricao="Preencha este balanço a cada 30 dias para acompanhar o crescimento real do seu patrimônio:"
        colunas={["Linha de Controle Financeiro", "Fórmula / Origem dos Dados", "Exemplo Operacional Real"]}
        largurasColunas={["28%", "44%", "28%"]}
        linhas={[
          ["Quantidade Produzida no Mês", "Contagem consolidada de todas as fornadas", "1.200 espetinhos"],
          ["Quantidade Vendida no Mês", "Total de espetos despachados nos kits e avulsos", "1.150 espetinhos"],
          ["Faturamento Bruto Total", "Vendas de kits + combos + taxas de frete", "R$ 9.775,00"],
          ["Custos com Matéria-Prima (Carnes)", "Notas fiscais de compras de carne limpa no açougue", "- R$ 4.025,00"],
          ["Custos com Insumos & Embalagens", "Palitos, temperos, sacos a vácuo e etiquetas", "- R$ 690,00"],
          ["Despesas Operacionais", "Reserva de energia do freezer, gás e combustível", "- R$ 480,00"],
          ["LUCRO LÍQUIDO REAL DO MÊS", "Faturamento Bruto menos Custos e Despesas Totais", "R$ 4.580,00 (46,8%)"],
