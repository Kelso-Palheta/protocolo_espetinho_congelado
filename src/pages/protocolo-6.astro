---
import EbookLayout from '../layouts/EbookLayout.astro';
import VisualBlock from '../components/VisualBlock.astro';
import CalloutAlerta from '../components/CalloutAlerta.astro';
import TabelaTecnica from '../components/TabelaTecnica.astro';
import ChecklistOperacional from '../components/ChecklistOperacional.astro';
import imgOferta from '../assets/illustrations/protocolo-6-oferta.png';
import imgCapa from '../assets/illustrations/capa-protocolo-6.png';
---

<EbookLayout
  title="Protocolo 6 — Oferta: Kits e Combos Lucrativos"
  category="protocolo"
  chapterNumber="06"
  chapterTitle="PROTOCOLO 6 — OFERTA"
  chapterSubtitle="A Arte de Criar Kits, Combos e Cardápios de Alta Conversão"
  focoTecnico="Ocasiões de Consumo & Ancoragem Visual"
  parametroChave="Grade de 3 Tickets & Pedido Mínimo"
  imagemCapa={imgCapa.src}
  prevLink={{ title: "Protocolo 5: Precificação", href: "/protocolo-5" }}
  nextLink={{ title: "Protocolo 7: Venda", href: "/protocolo-7" }}
>
  <!-- Prancha 2: Bloco Visual Hero (Ocupação Nobre de 90% da Página) -->
  <div class="prancha">
    <VisualBlock
      stepNumber="06"
      badge="Engenharia de Cardápio"
      title="Da Carne no Palito à Solução do Churrasco em Família"
      subtitle="Venda ocasiões resolvidas com ancoragem e ticket médio elevado"
      description="Anunciar palitos soltos a R$ 6,50 ou R$ 8,50 atrai pedidos miúdos de R$ 20,00 com o mesmo custo operacional de entrega. O segredo é vender soluções completas: Kit Degustação, Kit Churrasco em Família e Kit da Galera. A ancoragem de preços evidencia uma economia real para o cliente enquanto blinda sua margem líquida."
      tip="Mostre sempre o preço avulso riscado ao lado do valor do kit fechado (Ex: 'De R$ 140,00 por apenas R$ 119,00'). Isso gera decisão instantânea sem margem para contrapropostas."
      imageSrc={imgOferta.src}
      imageAlt="Kits e combos de churrasco em embalagens a vácuo sobre ardósia com sal grosso e ervas frescas"
      imagePosition="right"
    />
  </div>

  <!-- Prancha 3: Seção 1 - A Diferença Entre Vender Produto Solto e Vender uma Ocasião de Consumo -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-2">
        <h2 class="secao-titulo">
          <span class="text-amber-500">1.</span> Vender Produto Solto vs. Vender uma Ocasião de Consumo
        </h2>
        <p class="secao-intro">
          O amador anuncia carne no palito: <em>"Espetinho de frango a R$ 6,50 e carne a R$ 8,50"</em>. O cliente pede duas ou três unidades (ticket de R$ 20,00), exigindo o mesmo trabalho de separação, embalagem e entrega de um pedido quatro vezes maior.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3.5 flex-1 my-2">
        <!-- O Modelo Amador -->
        <div class="subcard-item border-rose-500/30 bg-rose-950/10 p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag zinc">O Modelo Falho</span>
              <span class="text-rose-400 font-mono text-xs font-bold">Palito Solto</span>
            </div>
            <h3 class="subcard-titulo text-rose-300 text-sm">Venda Fracionada e Avulsa</h3>
            <ul class="lista-topicos text-xs gap-2 text-zinc-300 mt-2">
              <li>
                <span class="marcador-amber text-rose-400">•</span>
                <span><strong>Foco no Preço Unitário:</strong> O cliente fica comparando o valor do palito com o boteco da esquina.</span>
              </li>
              <li>
                <span class="marcador-amber text-rose-400">•</span>
                <span><strong>Ticket Médio Baixo (R$ 20):</strong> Não cobre a taxa de entrega nem o tempo de congelamento do lote.</span>
              </li>
              <li>
                <span class="marcador-amber text-rose-400">•</span>
                <span><strong>Sobras Desbalanceadas:</strong> Saem 20 espetos de frango e sobram carnes nobres despadronizadas no freezer.</span>
              </li>
            </ul>
          </div>
          <div class="mt-2 pt-2 border-t border-rose-900/40 text-[11px] text-rose-300/80">
            Resultado: Muito esforço operacional para pouco lucro líquido no bolso.
          </div>
        </div>

        <!-- O Modelo Oficial do Protocolo -->
        <div class="subcard-item border-emerald-500/30 bg-emerald-950/10 p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">O Padrão Oficial</span>
              <span class="text-emerald-400 font-mono text-xs font-bold">Ocasião Resolvida</span>
            </div>
            <h3 class="subcard-titulo text-emerald-300 text-sm">Combos e Kits Estruturados</h3>
            <ul class="lista-topicos text-xs gap-2 text-zinc-300 mt-2">
              <li>
                <span class="marcador-amber text-emerald-400">•</span>
                <span><strong>Experiência Pronta:</strong> Resolve o almoço da família, a resenha de amigos ou o estoque do mês.</span>
              </li>
              <li>
                <span class="marcador-amber text-emerald-400">•</span>
                <span><strong>Ticket Médio Alto (R$ 119 a R$ 240):</strong> Garante mais de R$ 50 de lucro limpo a cada entrega.</span>
              </li>
              <li>
                <span class="marcador-amber text-emerald-400">•</span>
                <span><strong>Giro Equilibrado de Carnes:</strong> Mescla cortes nobres e de alto giro sem deixar estoque encalhado.</span>
              </li>
            </ul>
          </div>
          <div class="mt-2 pt-2 border-t border-emerald-900/40 text-[11px] text-emerald-300/80">
            Resultado: Escala rápida, lucro consistente e alta fidelização do cliente.
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="perigo"
        titulo="Alerta Operacional: Proibido Operar com Ticket Médio Abaixo de R$ 60"
        destaque="Proteção da Logística Doméstica"
        mensagem="Cada deslocamento de motoboy ou entrega própria exige embalagem protetora, tempo de conversa no WhatsApp e controle de estoque. Se o cliente puder pedir R$ 15,00 ou R$ 20,00, sua margem de lucro evapora nos custos invisíveis."
      />
    </section>
  </div>

  <!-- Prancha 4: Seção 2 - A Matriz de Kits e Combos de Alto Giro -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">2.</span> A Matriz de Kits e Combos de Alto Giro (Grade de 3 Níveis)
        </h2>
        <p class="secao-intro">
          O segredo de um cardápio lucrativo é manter poucas opções, porém extremamente bem desenhadas para cada perfil de cliente:
        </p>
      </div>

      <div class="grid grid-cols-3 gap-3 flex-1 my-2">
        <!-- Nível 1 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag zinc">Nível 01 • Entrada</span>
              <span class="text-xs text-zinc-400 font-mono">10 a 12 un</span>
            </div>
            <h3 class="subcard-titulo text-xs">Kit Degustação / Casal</h3>
            <p class="subcard-texto text-[11px] mb-2">
              <strong>Objetivo:</strong> Quebrar a barreira de desconfiança do cliente de primeira viagem.
            </p>
            <div class="space-y-1 text-[11px] text-zinc-300 font-mono bg-charcoal-900 p-2 rounded-lg border border-charcoal-800">
              <p>• 4 Bovinos Tradicionais</p>
              <p>• 4 Frangos com Bacon</p>
              <p>• 4 Linguiças Toscanas</p>
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-charcoal-800 flex items-center justify-between">
            <span class="text-[10.5px] text-zinc-400">Para 2 pessoas</span>
            <span class="font-mono text-xs font-bold text-amber-400">R$ 65 a R$ 75</span>
          </div>
        </div>

        <!-- Nível 2 (Destaque Campeão) -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/40 bg-amber-950/15">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Nível 02 • O Campeão</span>
              <span class="badge-tag emerald">Mais Vendido</span>
            </div>
            <h3 class="subcard-titulo text-xs text-amber-300">Kit Churrasco em Família</h3>
            <p class="subcard-texto text-[11px] mb-2">
              <strong>Objetivo:</strong> O coração do faturamento, respondendo por 70% das vendas da semana.
            </p>
            <div class="space-y-1 text-[11px] text-zinc-200 font-mono bg-charcoal-950 p-2 rounded-lg border border-amber-500/30">
              <p>• 10 Bovinos Tradicionais</p>
              <p>• 6 Frangos com Bacon</p>
              <p>• 6 Linguiças Selecionadas</p>
              <p class="text-amber-400">+ Opcional: Queijo ou Pão de Alho</p>
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-amber-900/40 flex items-center justify-between">
            <span class="text-[10.5px] text-zinc-300">4 a 6 pessoas</span>
            <span class="font-mono text-sm font-black text-amber-400">R$ 119 a R$ 139</span>
          </div>
        </div>

        <!-- Nível 3 -->
        <div class="subcard-item p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag emerald">Nível 03 • Eventos</span>
              <span class="text-xs text-emerald-400 font-mono">40 a 50 un</span>
            </div>
            <h3 class="subcard-titulo text-xs">Pacote da Galera / Eventos</h3>
            <p class="subcard-texto text-[11px] mb-2">
              <strong>Objetivo:</strong> Alavancar o faturamento com aniversários e resenhas corporativas.
            </p>
            <div class="space-y-1 text-[11px] text-zinc-300 font-mono bg-charcoal-900 p-2 rounded-lg border border-charcoal-800">
              <p>• 20 Bovinos Nobres</p>
              <p>• 15 Frangos com Bacon</p>
              <p>• 15 Linguiças Artesanais</p>
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-charcoal-800 flex items-center justify-between">
            <span class="text-[10.5px] text-zinc-400">8 a 12 pessoas</span>
            <span class="font-mono text-xs font-bold text-amber-400">R$ 220 a R$ 260</span>
          </div>
        </div>
      </div>

      <div class="p-3 rounded-xl bg-charcoal-950 border border-charcoal-800 flex items-center justify-between">
        <span class="text-xs text-zinc-300">
          <strong>Diretriz de Simplicidade:</strong> Evite cardápios com 15 sabores diferentes no início. A grade com 3 kits baseados nos 3 sabores clássicos gera agilidade máxima de bancada e giro semanal rápido.
        </span>
        <span class="badge-tag amber">Foco Operacional</span>
      </div>
    </section>
  </div>

  <!-- Prancha 5: Seção 3 - Ancoragem de Preço e a Política de Pedido Mínimo -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">3.</span> Ancoragem de Preço e a Política de Pedido Mínimo
        </h2>
        <p class="secao-intro">
          Para o cliente decidir rapidamente pelo combo em vez de unidades soltas, aplique as duas regras mestras de conversão visual:
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3.5 flex-1 my-2">
        <!-- Ancoragem Visual -->
        <div class="subcard-item p-4 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag amber">Técnica Psicológica</span>
              <span class="text-amber-400 font-mono text-xs font-bold">Ancoragem</span>
            </div>
            <h3 class="subcard-titulo text-sm text-zinc-100">Preço Avulso Riscado vs. Preço do Kit</h3>
            <p class="subcard-texto text-xs mb-3 text-zinc-300">
              Sempre mostre a soma individual de tabela riscada imediatamente ao lado do valor promocional do pacote:
            </p>
            <div class="p-3 rounded-lg bg-charcoal-900 border border-charcoal-800 text-center font-mono my-2">
              <span class="line-through text-rose-400/80 text-sm">De R$ 140,00</span>
              <span class="text-emerald-400 font-black text-lg ml-3">Por apenas R$ 119,00</span>
            </div>
            <p class="text-[11px] text-zinc-400">
              O comprador enxerga a vantagem imediata de <strong>economizar R$ 21,00</strong>, enquanto você garante R$ 54,00 de lucro limpo no pacote.
            </p>
          </div>
        </div>

        <!-- Pedido Mínimo -->
        <div class="subcard-item p-4 flex flex-col justify-between border-rose-500/30 bg-rose-950/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="badge-tag zinc">Trava Operacional</span>
              <span class="text-rose-400 font-mono text-xs font-bold">Regra Inegociável</span>
            </div>
            <h3 class="subcard-titulo text-sm text-rose-300">Política Rígida de Pedido Mínimo</h3>
            <p class="subcard-texto text-xs mb-3 text-zinc-300">
              Defina no rodapé do cardápio a quantidade e o valor mínimo para liberação de qualquer entrega ou retirada:
            </p>
            <div class="p-3 rounded-lg bg-charcoal-900 border border-charcoal-800 text-center font-mono my-2">
              <span class="text-zinc-100 font-bold text-xs">MÍNIMO: 1 PACOTE FECHADO (10 UNIDADES) OU R$ 60,00</span>
            </div>
            <p class="text-[11px] text-zinc-400">
              Elimina pedidos de 2 ou 3 palitos que consomem sacos a vácuo, etiquetas e tempo de atendimento com prejuízo.
            </p>
          </div>
        </div>
      </div>

      <CalloutAlerta
        tipo="norma"
        titulo="Norma Comercial: O Cardápio Não Negocia Unidades Avulsas"
        destaque="Venda Apenas Pacotes Fechados a Vácuo"
        mensagem="Seus espetinhos já estão selados a vácuo em frações de 4 ou 10 unidades. Se o cliente insistir em comprar 3 unidades soltas, explique com gentileza: 'Nossos espetos são selados em atmosfera protegida a vácuo para não queimar no freezer. Para manter o padrão higiênico, vendemos apenas pacotes lacrados'."
      />
    </section>
  </div>

  <!-- Prancha 6: Seção 4 - Construção do Modelo de Cardápio Digital Enxuto -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">4.</span> Construção do Modelo de Cardápio Digital Enxuto
        </h2>
        <p class="secao-intro">
          O cardápio para WhatsApp deve ser visual, direto e carregar em menos de dois segundos no celular. Nada de PDFs pesados de 20 páginas ou links com login obrigatório:
        </p>
      </div>

      <div class="grid grid-cols-4 gap-2.5 flex-1 my-2">
        <!-- Bloco 1 -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Bloco 01</span>
            <h3 class="subcard-titulo text-xs">Topo & Slogan</h3>
            <p class="subcard-texto text-[11px]">
              Sua marca/logo + Slogan: <em>"Espetinhos Artesanais Congelados — Direto do Freezer para sua Brasa"</em>.
            </p>
          </div>
        </div>

        <!-- Bloco 2 -->
        <div class="subcard-item p-3 flex flex-col justify-between border-amber-500/30 bg-amber-950/10">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Bloco 02</span>
            <h3 class="subcard-titulo text-xs text-amber-300">Kits Principais</h3>
            <p class="subcard-texto text-[11px]">
              Kits Degustação, Família e Galera com pesos aproximados, número de pessoas e preços ancorados.
            </p>
          </div>
        </div>

        <!-- Bloco 3 -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Bloco 03</span>
            <h3 class="subcard-titulo text-xs">Mono-Sabores</h3>
            <p class="subcard-texto text-[11px]">
              Pacotes fechados com 10 unidades de um único sabor (Bovino R$ 85, Frango R$ 65, Linguiça R$ 55).
            </p>
          </div>
        </div>

        <!-- Bloco 4 -->
        <div class="subcard-item p-3 flex flex-col justify-between">
          <div>
            <span class="badge-tag amber mb-1.5 inline-block">Bloco 04</span>
            <h3 class="subcard-titulo text-xs">Rodapé Operacional</h3>
            <p class="subcard-texto text-[11px]">
              Dias de entrega, formas de pagamento (Pix/Cartão), regras de encomenda e taxa de entrega por bairro.
            </p>
          </div>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-charcoal-950 border border-charcoal-800 flex items-center justify-between">
        <div class="space-y-0.5 max-w-[80%]">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">A Regra da Fotografia Real (Zero Banco de Imagens)</span>
          <p class="text-xs text-zinc-300">
            Fotografe seus próprios espetinhos na bancada limpa (crus a vácuo) e assados dourados na tábua. O cliente compra a confiança e a verdade do padrão artesanal caseiro.
          </p>
        </div>
        <span class="badge-tag emerald">Fotos Autênticas</span>
      </div>
    </section>
  </div>

  <!-- Prancha 7: Seção 5 - Estrutura da Oferta Irresistível no WhatsApp -->
  <div class="prancha">
    <section class="card-prancha">
      <div class="secao-header mb-1">
        <h2 class="secao-titulo">
          <span class="text-amber-500">5.</span> Estrutura da Oferta Irresistível (Mensagem de Venda Rápida)
        </h2>
        <p class="secao-intro">
          Quando o cliente pedir o cardápio no WhatsApp, nunca envie a imagem solta sem contexto. Conduza o diálogo com o script oficial de conversão em 4 etapas:
        </p>
      </div>

      <!-- Script Visual Estilizado -->
      <div class="p-4 rounded-xl bg-charcoal-950 border border-emerald-500/30 flex-1 my-2 flex flex-col justify-between">
        <div class="flex items-center justify-between border-b border-charcoal-800 pb-2 mb-2">
          <span class="text-xs font-bold text-emerald-400 font-mono">📱 SCRIPT OFICIAL DE FECHAMENTO NO WHATSAPP</span>
          <span class="badge-tag emerald">ALTA CONVERSÃO</span>
        </div>

        <div class="space-y-2 text-xs text-zinc-200 leading-relaxed font-sans">
          <p class="text-zinc-300">
            "Olá! Tudo bem? Aqui estão nossas opções de espetinhos artesanais congelados para o seu fim de semana! 🥩🔥"
          </p>
          <p class="text-zinc-300">
            "Nossos produtos são 100% padronizados (100 g cada), temperados com marinada natural e selados a vácuo na medida certa para você guardar no freezer e assar direto na grelha quando quiser."
          </p>
          <p class="bg-emerald-950/40 p-2.5 rounded-lg border border-emerald-500/30 text-emerald-300 font-semibold">
            "Nosso destaque desta semana é o <strong>Kit Churrasco em Família (20 unidades)</strong>, que já vem com carnes nobres, frango com bacon e linguiça selecionada por apenas <strong>R$ 119,00</strong> (uma economia de mais de R$ 20,00 em relação à tabela avulsa)!"
          </p>
          <p class="text-amber-300 font-bold">
            "Você prefere retirar aqui conosco ou quer que agendemos a entrega no seu endereço?"
          </p>
        </div>

        <div class="mt-2 pt-2 border-t border-charcoal-800 flex items-center justify-between text-[11px] text-zinc-400">
          <span>O fechamento em dupla alternativa elimina o 'vou pensar' e direciona para o pedido.</span>
          <span class="text-amber-400 font-mono font-semibold">FECHAMENTO DIRETO</span>
        </div>
      </div>
    </section>
  </div>

  <!-- Prancha 8: Seção 5.1 - Matriz de Combos e Engenharia de Margem do Cardápio (Tabela Técnica) -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <TabelaTecnica
        titulo="Engenharia de Cardápio: Ancoragem, Descontos e Lucro Líquido por Kit"
        descricao="Demonstração da preservação de margem na venda de pacotes e combos em relação à tabela avulsa:"
        colunas={["Item do Cardápio", "Composição / Unidades", "Tabela Avulsa", "Preço do Combo", "Economia do Cliente", "Lucro Limpo no Bolso"]}
        linhas={[
          ["Kit Degustação / Casal", "12 un (4 Bov + 4 Frang + 4 Ling)", "R$ 82,00", "R$ 69,00", "R$ 13,00 (15,8%)", "R$ 32,00 (46,3%)"],
          ["Kit Churrasco em Família", "20 un (10 Bov + 6 Frang + 6 Ling)", "R$ 140,00", "R$ 119,00", "R$ 21,00 (15,0%)", "R$ 54,00 (45,3%)"],
          ["Pacote da Galera / Eventos", "50 un (20 Bov + 15 Frang + 15 Ling)", "R$ 350,00", "R$ 249,00", "R$ 101,00 (28,8%)", "R$ 111,00 (44,5%)"],
          ["Pacote Fechado Bovino", "10 un de Alcatra / Acém (1,0 kg)", "R$ 85,00", "R$ 79,00", "R$ 6,00 (7,0%)", "R$ 31,50 (39,8%)"],
          ["Pacote Fechado Frango c/ Bacon", "10 un de Medalhões (1,0 kg)", "R$ 65,00", "R$ 59,00", "R$ 6,00 (9,2%)", "R$ 33,00 (55,9%)"],
          ["Pacote Fechado Linguiça", "10 un de Toscana Artesanal (1,0 kg)", "R$ 55,00", "R$ 49,00", "R$ 6,00 (10,9%)", "R$ 30,00 (61,2%)"]
        ]}
        destaqueIndice={1}
        rodape="Dica de Conversão: O Kit Churrasco em Família entrega o equilíbrio exato entre volume de vendas, facilidade de montagem e mais de R$ 50,00 de lucro limpo por cliente."
      />
    </div>
  </div>

  <!-- Prancha 9: Seção 6 - Checklist Prático do Protocolo 6 -->
  <div class="prancha">
    <div class="card-prancha flex flex-col justify-between p-6">
      <ChecklistOperacional
        titulo="Checklist Prático de Execução do Protocolo 6"
        subtitulo="Auditoria comercial do cardápio e das ofertas ativas no WhatsApp:"
        itens={[
          { texto: "Grade de kits montada com três faixas claras de preço (Entrada, Principal e Evento).", obrigatorio: true, detalhe: "Degustação (R$ 69), Família (R$ 119) e Galera (R$ 249) definidos." },
          { texto: "Preços de kits calculados mesclando cortes nobres e de alto giro com lucro acima de 40%.", obrigatorio: true, detalhe: "Margem líquida protegida na mescla proporcional de sabores." },
