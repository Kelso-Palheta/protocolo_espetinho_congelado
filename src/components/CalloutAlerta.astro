---
interface Props {
  tipo?: 'temperatura' | 'perigo' | 'alerta' | 'norma' | 'dica';
  titulo?: string;
  destaque?: string;
  mensagem?: string;
  texto?: string;
  compacto?: boolean;
}

const {
  tipo = 'alerta',
  titulo,
  destaque,
  mensagem,
  texto,
  compacto = false
} = Astro.props;

const conteudo = mensagem || texto;

const tiposConfig = {
  temperatura: {
    icon: '❄️',
    border: 'border-cyan-500/40 hover:border-cyan-400/60',
    glow: 'from-cyan-950/40 to-charcoal-900',
    badgeBg: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30',
    defaultTitle: 'Ponto Crítico de Temperatura',
    accentText: 'text-cyan-400'
  },
  perigo: {
    icon: '⛔',
    border: 'border-rose-600/50 hover:border-rose-500/70',
    glow: 'from-rose-950/50 to-charcoal-900',
    badgeBg: 'bg-rose-500/10 text-rose-300 border-rose-500/30',
    defaultTitle: 'Alerta Crítico de Segurança',
    accentText: 'text-rose-400'
  },
  norma: {
    icon: '📜',
    border: 'border-amber-500/40 hover:border-amber-400/60',
    glow: 'from-amber-950/40 to-charcoal-900',
    badgeBg: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
    defaultTitle: 'Norma Técnica / Vácuo',
    accentText: 'text-amber-400'
  },
  alerta: {
    icon: '🔥',
    border: 'border-orange-500/40 hover:border-orange-400/60',
    glow: 'from-orange-950/40 to-charcoal-900',
    badgeBg: 'bg-orange-500/10 text-orange-300 border-orange-500/30',
    defaultTitle: 'Atenção Operacional',
    accentText: 'text-orange-400'
  },
  dica: {
    icon: '💡',
    border: 'border-emerald-500/40 hover:border-emerald-400/60',
    glow: 'from-emerald-950/40 to-charcoal-900',
    badgeBg: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
    defaultTitle: 'Dica Prática de Conversão',
    accentText: 'text-emerald-400'
  }
};

const config = tiposConfig[tipo as keyof typeof tiposConfig] || tiposConfig.alerta;
---

<aside class={`relative overflow-hidden border bg-gradient-to-br ${config.glow} ${config.border} shadow-xl backdrop-blur-md transition-all duration-300 ${compacto ? 'my-1.5 p-2.5 rounded-xl' : 'my-2.5 p-3.5 md:p-4 rounded-2xl'}`}>
  <!-- Glowing ember backdrop effect -->
  <div class="pointer-events-none absolute -right-8 -top-8 h-28 w-28 rounded-full bg-amber-500/10 blur-2xl"></div>
  
  <div class={`flex items-start ${compacto ? 'gap-2.5' : 'gap-3.5'}`}>
    <!-- Icon Container -->
    <div class={`shrink-0 flex items-center justify-center rounded-xl bg-charcoal-800/90 border border-charcoal-700/60 shadow-inner shadow-black/40 ${compacto ? 'h-8 w-8 text-base rounded-lg' : 'h-10 w-10 text-xl'}`}>
      <span>{config.icon}</span>
    </div>

    <!-- Content Block -->
    <div class="flex-1 space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <h4 class={`font-display font-bold text-zinc-100 tracking-tight ${compacto ? 'text-xs' : 'text-sm md:text-base'}`}>
          {titulo || config.defaultTitle}
        </h4>
        {destaque && (
          <span class={`rounded-full border px-2 py-0.5 text-[10.5px] font-mono font-bold tracking-wide ${config.badgeBg}`}>
            {destaque}
          </span>
        )}
      </div>

      <div class={`text-zinc-300/90 leading-relaxed ${compacto ? 'text-[10.5px]' : 'text-xs md:text-sm'}`}>
        {conteudo ? <p>{conteudo}</p> : <slot />}
      </div>
    </div>
  </div>
</aside>
