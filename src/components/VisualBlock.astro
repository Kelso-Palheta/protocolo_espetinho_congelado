---
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  badge?: string;
  stepNumber?: number | string;
  title: string;
  subtitle?: string;
  description?: string;
  imagePosition?: 'left' | 'right';
  tip?: string;
}

const {
  imageSrc,
  imageAlt = "Ilustração do protocolo",
  badge,
  stepNumber,
  title,
  subtitle,
  description,
  imagePosition = 'left',
  tip
} = Astro.props;
---

<article class={`visual-block card-elegant ${imagePosition === 'right' ? 'layout-reversed' : ''}`}>
  <div class="visual-media">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt} loading="lazy" class="visual-image" />
    ) : (
      <div class="visual-placeholder">
        <div class="placeholder-icon">🍖</div>
        <p class="placeholder-label">Espaço para ilustração IA</p>
        <span class="placeholder-sub">src/assets/illustrations/</span>
      </div>
    )}
  </div>

  <div class="visual-content">
    <div class="meta-header">
      {stepNumber && <span class="step-pill">Passo {stepNumber}</span>}
      {badge && <span class="tag-badge">{badge}</span>}
    </div>

    <h3 class="visual-title">{title}</h3>
    {subtitle && <h4 class="visual-subtitle">{subtitle}</h4>}
    {description && <p class="visual-desc">{description}</p>}

    <slot />

    {tip && (
      <div class="pro-tip">
        <span class="tip-icon">💡</span>
        <div class="tip-content">
          <strong>Dica de Ouro:</strong> {tip}
        </div>
      </div>
    )}
  </div>
</article>

<style>
  .visual-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    margin-bottom: 2rem;
  }

  .visual-block:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 35px -5px rgba(245, 158, 11, 0.1), 0 10px 15px -5px rgba(0, 0, 0, 0.6);
  }

  .layout-reversed {
    direction: rtl;
  }

  .layout-reversed > * {
    direction: ltr;
  }

  .visual-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    overflow: hidden;
    background: #09090b;
    border: 1px solid #27272a;
  }

  .visual-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 14px;
    filter: brightness(0.95) contrast(1.05);
  }

  .visual-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    width: 100%;
    border: 2px dashed #78350f;
    border-radius: 14px;
    background: #09090b;
  }

  .placeholder-icon {
    font-size: 2.75rem;
    margin-bottom: 0.5rem;
  }

  .placeholder-label {
    font-weight: 600;
    color: #f59e0b;
    margin: 0;
    font-size: 0.95rem;
  }

  .placeholder-sub {
    font-size: 0.75rem;
    color: #a1a1aa;
    font-family: monospace;
    margin-top: 0.35rem;
  }

  .visual-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }

  .meta-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
    flex-shrink: 0;
  }

  .step-pill {
    background: #be123c;
    color: #ffffff;
    font-size: 0.825rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }

  .tag-badge {
    background: rgba(245, 158, 11, 0.15);
    color: #fcd34d;
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .visual-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #fafafa;
    margin: 0 0 0.75rem 0;
    line-height: 1.25;
    flex-shrink: 0;
  }

  .visual-subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    color: #fbbf24;
    margin: 0 0 1rem 0;
    line-height: 1.35;
    flex-shrink: 0;
  }

  .visual-desc {
    color: #d4d4d8;
    font-size: 1rem;
    line-height: 1.65;
    margin: 0;
    flex-shrink: 0;
  }

  .pro-tip {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(245, 158, 11, 0.09);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 1rem 1.25rem;
    border-radius: 12px;
    margin-top: auto;
    flex-shrink: 0;
  }

  .tip-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .tip-content {
    font-size: 0.875rem;
    color: #fef08a;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .visual-block {
      grid-template-columns: 1fr;
      direction: ltr !important;
    }
    
    .visual-block > * {
      direction: ltr !important;
    }

    .visual-media {
      min-height: 190px;
    }
  }

  @media print {
    .visual-block {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      background: #18181b !important;
      border: 1px solid #27272a !important;
    }
  }
</style>
